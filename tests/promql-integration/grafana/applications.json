{
  "id": null,
  "uid": "nd-promql-apps",
  "title": "Netdata / Applications",
  "description": "Application groups, process/thread counts, CPU, memory and I/O. CPU and I/O are gauges here.",
  "tags": [
    "netdata",
    "promql-playground"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 0,
  "refresh": "1m",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "24h",
      "7d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Netdata PromQL",
          "value": "netdata-promql"
        },
        "refresh": 1,
        "options": []
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(system_cpu, netdata_host_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(system_cpu, netdata_host_name)",
          "refId": "host-variable",
          "label": "netdata_host_name",
          "metric": "system_cpu"
        },
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
        "current": {
          "text": "promql",
          "value": "promql"
        }
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(app_cpu_utilization{netdata_host_name=~\"${host}\"}, app_group)",
        "query": {
          "qryType": 1,
          "query": "label_values(app_cpu_utilization{netdata_host_name=~\"${host}\"}, app_group)",
          "refId": "application-variable",
          "label": "app_group",
          "metric": "app_cpu_utilization{netdata_host_name=~\"${host}\"}"
        },
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "promql-playground"
      ],
      "title": "Netdata dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Application CPU total",
      "description": "Already a gauge.100% means one CPU core; total may exceed100%.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:% of one core",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (netdata_host_id, netdata_host_name) (app_cpu_utilization{netdata_host_name=~\"${host}\",app_group=~\"${application}\"})",
          "editorMode": "code",
          "legendFormat": "{{netdata_host_name}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
