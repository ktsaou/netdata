func netdataHelperLabels(input labels.Labels) any {
	rows := []any{}
	input.Range(func(label labels.Label) {
		rows = append(rows, map[string]any{"name": netdataHelperBytes(label.Name), "value": netdataHelperBytes(label.Value)})
	})
	return rows
}

func netdataHelperDSLAssertions(cmd *evalCmd) any {
	rows := []any{}
	positions := make([]uint64, 0, len(cmd.expected))
	for hash := range cmd.expected { positions = append(positions, hash) }
	sort.Slice(positions, func(i, j int) bool { return cmd.expected[positions[i]].pos < cmd.expected[positions[j]].pos })
	for _, hash := range positions {
		entry := cmd.expected[hash]
		if len(entry.vals) != 1 || entry.vals[0].Histogram != nil { panic("changed direct native helper declaration") }
		rows = append(rows, map[string]any{"position": entry.pos, "labels": netdataHelperLabels(cmd.metrics[hash]),
			"value": netdataHelperBits(entry.vals[0].Value)})
	}
	annotationCommands := []any{}
	for kind := Ordered; kind <= NoInfo; kind++ {
		for _, assertion := range cmd.expectedCmds[kind] {
			annotationCommands = append(annotationCommands, map[string]any{"kind": int(kind), "type": assertion.Type(),
				"value": netdataHelperBytes(assertion.String())})
		}
	}
	return map[string]any{"rows": rows, "annotation_commands": annotationCommands, "warn": cmd.warn, "info": cmd.info,
		"ordered": cmd.ordered, "failure": cmd.fail, "exclude_generated_range": cmd.excludeFromRangeQuery}
}

func netdataHelperCaptureDSL(t *testing.T, input string, engine *promql.Engine, output *[]map[string]any) []any {
	suite, err := newTest(t, input, false, newTestStorage)
	require.NoError(t, err)
	defer func() {
		if suite.storage != nil { require.NoError(t, suite.storage.Close()) }
		if suite.cancelCtx != nil { suite.cancelCtx() }
	}()
	commands := []any{}
	for _, command := range suite.cmds {
		cmd, evaluation := command.(*evalCmd)
		if !evaluation { require.NoError(t, suite.exec(command, engine)); continue }
		if cmd.isRange { continue }
		expression, err := parser.NewParser(TestParserOpts).ParseExpr(cmd.expr)
		require.NoError(t, err)
		call, ok := expression.(*parser.Call)
		if !ok || (call.Func.Name != "histogram_fraction" && call.Func.Name != "histogram_quantile") { continue }
		// These original commands exercise classic/conflicting histograms, not the native scalar helpers.
		if call.Func.Name == "histogram_quantile" && (cmd.line == 1904 || cmd.line == 1908 || cmd.line == 1911 || cmd.line == 1914) { continue }
		quantile := call.Func.Name == "histogram_quantile"
		vectorIndex := 2
		if quantile { vectorIndex = 1 }
		argumentRanges := []any{}
		argumentQueries := []string{}
		for _, arg := range call.Args {
			pos := arg.PositionRange()
			require.True(t, pos.Start >= 0 && pos.End >= pos.Start && int(pos.End) <= len(cmd.expr))
			argumentRanges = append(argumentRanges, map[string]any{"start": pos.Start, "end": pos.End})
			argumentQueries = append(argumentQueries, cmd.expr[pos.Start:pos.End])
		}
		source := map[string]any{"file": "promql/promqltest/testdata/native_histograms.test", "line": cmd.line,
			"query": netdataHelperBytes(cmd.expr), "function": call.Func.Name, "evaluation_time_ms": cmd.eval.UnixMilli(),
			"argument_ranges": argumentRanges, "argument_queries": argumentQueries, "parser_options": TestParserOpts,
			"declarations": netdataHelperDSLAssertions(cmd)}
		commands = append(commands, netdataHelperFreeze(source))
		scalar := func(index int) float64 {
			query, err := engine.NewInstantQuery(suite.context, suite.storage, nil, argumentQueries[index], cmd.eval)
			require.NoError(t, err)
			defer query.Close()
			result := query.Exec(suite.context)
			require.NoError(t, result.Err)
			value, ok := result.Value.(promql.Scalar)
			require.True(t, ok, "non-scalar original helper argument")
			return value.V
		}
		lower, upper := scalar(0), float64(0)
		if !quantile { upper = scalar(1) }
		func() {
			query, err := engine.NewInstantQuery(suite.context, suite.storage, nil, argumentQueries[vectorIndex], cmd.eval)
			require.NoError(t, err)
			defer query.Close()
			result := query.Exec(suite.context)
			require.NoError(t, result.Err)
			vector, ok := result.Value.(promql.Vector)
			require.True(t, ok, "non-vector original helper argument")
			seen := map[int]bool{}
			for _, sample := range vector {
				require.NotNil(t, sample.H, "non-native sample in direct helper roster")
				outputLabels := sample.Metric.DropReserved(schema.IsMetadataLabel)
				expected, exists := cmd.expected[outputLabels.Hash()]
				require.True(t, exists, "argument sample lacks original output declaration")
				require.False(t, seen[expected.pos], "duplicate original output declaration")
				seen[expected.pos] = true
				metric := sample.Metric.Get(labels.MetricName)
				pos := call.Args[vectorIndex].PositionRange()
				request := netdataHelperRequest(sample.H, lower, upper, quantile, metric, cmd.expr, pos)
				var value float64
				var annos annotations.Annotations
				if quantile { value, annos = promql.HistogramQuantile(lower, sample.H, metric, pos) } else {
					value, annos = promql.HistogramFraction(lower, upper, sample.H, metric, pos)
				}
				rowSource := map[string]any{"command": source, "row": expected.pos, "argument_labels": netdataHelperLabels(sample.Metric),
					"argument_sample_time_ms": sample.T, "output_labels": netdataHelperLabels(outputLabels)}
				declared := map[string]any{"comparison": "almost", "value": netdataHelperBits(expected.vals[0].Value)}
				id := fmt.Sprintf("dsl:native_histograms.test:%d:%03d", cmd.line, expected.pos-1)
				netdataHelperRecord(output, id, request, sample.H, value, annos, cmd.expr, quantile, declared, rowSource)
			}
			require.Len(t, seen, len(cmd.expected), "original helper sample expansion changed")
		}()
	}
	sort.Slice(*output, func(i, j int) bool { return (*output)[i]["id"].(string) < (*output)[j]["id"].(string) })
	return commands
}
