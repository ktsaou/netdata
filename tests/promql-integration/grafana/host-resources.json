{
  "id": null,
  "uid": "nd-promql-host",
  "title": "Netdata / Host Resources",
  "description": "CPU, memory, load and temporal summaries in native Netdata units.",
  "tags": [
    "netdata",
    "promql-playground"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 0,
  "refresh": "1m",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "24h",
      "7d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Netdata PromQL",
          "value": "netdata-promql"
        },
        "refresh": 1,
        "options": []
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(system_cpu, netdata_host_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(system_cpu, netdata_host_name)",
          "refId": "host-variable",
          "label": "netdata_host_name",
          "metric": "system_cpu"
        },
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
        "current": {
          "text": "promql",
          "value": "promql"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "promql-playground"
      ],
      "title": "Netdata dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "CPU busy",
      "description": "100 minus idle.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "(100 - avg by (netdata_host_id, netdata_host_name) (system_cpu{netdata_host_name=~\"${host:regex}\",netdata_dimension_id=\"idle\"}))",
          "editorMode": "code",
          "legendFormat": "{{netdata_host_name}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "RAM used",
      "description": "Native Netdata MiB; no byte conversion.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:MiB",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (netdata_host_id, netdata_host_name) (system_ram{netdata_host_name=~\"${host:regex}\",netdata_dimension_id=\"used\"})",
          "editorMode": "code",
          "legendFormat": "{{netdata_host_name}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Peak CPU busy \u00b7 last 5m",
      "description": "Maximum of CPU busy sampled every30seconds over five minutes.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(((100 - avg by (netdata_host_id, netdata_host_name) (system_cpu{netdata_host_name=~\"${host:regex}\",netdata_dimension_id=\"idle\"})))[5m:30s])",
          "editorMode": "code",
          "legendFormat": "{{netdata_host_name}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU p95 \u00b7 last 30m",
      "description": "95th percentile of one-minute CPU busy samples; not a request latency percentile.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, ((100 - avg by (netdata_host_id, netdata_host_name) (system_cpu{netdata_host_name=~\"${host:regex}\",netdata_dimension_id=\"idle\"})))[30m:1m])",
          "editorMode": "code",
          "legendFormat": "{{netdata_host_name}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU modes",
      "description": "Percent-of-total CPU dimensions are gauges, not counters.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        }
      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (netdata_host_id, netdata_host_name, netdata_dimension_id) (system_cpu{netdata_host_name=~\"${host:regex}\"})",
          "editorMode": "code",
          "legendFormat": "{{netdata_host_name}} / {{netdata_dimension_id}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
