func netdataStatisticMode(function string) string {
	return map[string]string{"histogram_count": "histogram-count", "histogram_sum": "histogram-sum", "histogram_avg": "histogram-avg",
		"histogram_stddev": "histogram-stddev", "histogram_stdvar": "histogram-stdvar"}[function]
}

var netdataStatisticOriginals = map[string]promql.FunctionCall{
	"histogram_count": promql.FunctionCalls["histogram_count"], "histogram_sum": promql.FunctionCalls["histogram_sum"],
	"histogram_avg": promql.FunctionCalls["histogram_avg"], "histogram_stdvar": promql.FunctionCalls["histogram_stdvar"],
	"histogram_stddev": promql.FunctionCalls["histogram_stddev"],
}

func netdataStatisticLabels(input labels.Labels) any {
	rows := []any{}
	input.Range(func(label labels.Label) { rows = append(rows, map[string]any{"name": netdataHelperBytes(label.Name), "value": netdataHelperBytes(label.Value)}) })
	return rows
}

func netdataStatisticDeclarations(cmd *evalCmd) any {
	rows := []any{}
	keys := make([]uint64, 0, len(cmd.expected))
	for key := range cmd.expected { keys = append(keys, key) }
	sort.Slice(keys, func(i, j int) bool { return cmd.expected[keys[i]].pos < cmd.expected[keys[j]].pos })
	for _, key := range keys {
		entry := cmd.expected[key]
		values := []string{}
		for _, value := range entry.vals {
			if value.Histogram != nil || value.Omitted { panic("changed statistic source declaration") }
			values = append(values, netdataHelperBits(value.Value))
		}
		rows = append(rows, map[string]any{"position": entry.pos, "labels": netdataStatisticLabels(cmd.metrics[key]), "values": values})
	}
	annotationCommands := []any{}
	for kind := Ordered; kind <= NoInfo; kind++ {
		for _, assertion := range cmd.expectedCmds[kind] { annotationCommands = append(annotationCommands,
			map[string]any{"kind": int(kind), "type": assertion.Type(), "value": netdataHelperBytes(assertion.String())}) }
	}
	return map[string]any{"rows": rows, "annotation_commands": annotationCommands, "warn": cmd.warn, "info": cmd.info,
		"ordered": cmd.ordered, "failure": cmd.fail, "exclude_generated_range": cmd.excludeFromRangeQuery}
}

func netdataStatisticRecord(t *testing.T, output *[]map[string]any, id, function string, h *histogram.FloatHistogram, declared, source any) {
	t.Helper()
	request := netdataHelperFreeze(map[string]any{"input": netdataHelperHistogram(h)})
	fn, exists := netdataStatisticOriginals[function]
	require.True(t, exists)
	values, annos := fn([]promql.Vector{{{H: h}}}, nil, nil, &promql.EvalNodeHelper{})
	require.Len(t, values, 1)
	require.Nil(t, values[0].H)
	require.True(t, values[0].DropName)
	require.Nil(t, annos)
	value := values[0].F
	reciprocal := 1 / value
	actual := map[string]any{"value": netdataHelperBits(value), "input_after": netdataHelperHistogram(h), "annotations": nil,
		"reciprocal": netdataHelperBits(reciprocal), "negative_reciprocal_infinite": reciprocal == math.Inf(-1),
		"positive_reciprocal_infinite": reciprocal == math.Inf(1), "less_than_positive_infinity": value < math.Inf(1),
		"greater_than_compensation_threshold": value > 1666666666666668.0}
	*output = append(*output, map[string]any{"id": id, "mode": netdataStatisticMode(function), "request": request,
		"actual": netdataHelperFreeze(actual), "declared": netdataHelperFreeze(declared), "source": netdataHelperFreeze(source)})
}

func netdataStatisticCaptureDSL(t *testing.T, name, input string, engine *promql.Engine, output *[]map[string]any) []any {
	suite, err := newTest(t, input, false, newTestStorage)
	require.NoError(t, err)
	defer func() {
		if suite.storage != nil { require.NoError(t, suite.storage.Close()) }
		if suite.cancelCtx != nil { suite.cancelCtx() }
	}()
	commands := []any{}
	for _, command := range suite.cmds {
		cmd, evaluation := command.(*evalCmd)
		if !evaluation { require.NoError(t, suite.exec(command, engine)); continue }
		expression, err := parser.NewParser(TestParserOpts).ParseExpr(cmd.expr)
		require.NoError(t, err)
		call, ok := expression.(*parser.Call)
		if !ok || netdataStatisticMode(call.Func.Name) == "" { continue }
		require.Len(t, call.Args, 1)
		pos := call.Args[0].PositionRange()
		require.True(t, pos.Start >= 0 && pos.End >= pos.Start && int(pos.End) <= len(cmd.expr))
		argument := cmd.expr[pos.Start:pos.End]
		mode := "instant"
		if cmd.isRange { mode = "range" }
		source := map[string]any{"file": "promql/promqltest/testdata/" + name, "line": cmd.line, "query": netdataHelperBytes(cmd.expr),
			"function": call.Func.Name, "mode": mode, "evaluation_time_ms": cmd.eval.UnixMilli(), "range_start_ms": cmd.start.UnixMilli(),
			"range_end_ms": cmd.end.UnixMilli(), "range_step_ns": int64(cmd.step), "argument_range": map[string]any{"start": pos.Start, "end": pos.End},
			"argument_query": argument, "parser_options": TestParserOpts, "declarations": netdataStatisticDeclarations(cmd),
			"capture_boundary": "function_dispatch"}
		native, ignored := 0, 0
		seen := map[string]bool{}
		func() {
			observe := func(sample promql.Sample, evaluationTime int64) {
				if sample.H == nil { ignored++; return }
				labels := sample.Metric.DropReserved(schema.IsMetadataLabel)
				expected, exists := cmd.expected[labels.Hash()]
				require.True(t, exists, "native argument lacks an original statistic declaration at %s:%d: input %v, output %v, declared %v",
					name, cmd.line, sample.Metric, labels, cmd.metrics)
				step := 0
				if cmd.isRange {
					delta := evaluationTime - cmd.start.UnixMilli()
					require.True(t, delta >= 0 && delta%(int64(cmd.step)/int64(time.Millisecond)) == 0)
					step = int(delta/(int64(cmd.step)/int64(time.Millisecond)))
				}
				require.True(t, step < len(expected.vals))
				id := fmt.Sprintf("dsl:%s:%d:%03d:%03d", name, cmd.line, expected.pos-1, step)
				require.False(t, seen[id], "duplicate original statistic sample")
				seen[id], native = true, native+1
				rowSource := map[string]any{"file": source["file"], "line": cmd.line, "row": expected.pos, "step": step,
					"argument_labels": netdataStatisticLabels(sample.Metric), "sample_time_ms": sample.T,
					"evaluation_time_ms": evaluationTime, "output_labels": netdataStatisticLabels(labels)}
				netdataStatisticRecord(t, output, id, call.Func.Name, sample.H,
					map[string]any{"comparison": "almost", "value": netdataHelperBits(expected.vals[step].Value)}, rowSource)
			}
			original := netdataStatisticOriginals[call.Func.Name]
			promql.FunctionCalls[call.Func.Name] = func(vectors []promql.Vector, matrix promql.Matrix, args parser.Expressions,
				enh *promql.EvalNodeHelper) (promql.Vector, annotations.Annotations) {
				require.Len(t, vectors, 1)
				for _, sample := range vectors[0] { observe(sample, enh.Ts) }
				return original(vectors, matrix, args, enh)
			}
			defer func() { promql.FunctionCalls[call.Func.Name] = original }()
			var query promql.Query
			if cmd.isRange { query, err = engine.NewRangeQuery(suite.context, suite.storage, nil, cmd.expr, cmd.start, cmd.end, cmd.step) } else {
				query, err = engine.NewInstantQuery(suite.context, suite.storage, nil, cmd.expr, cmd.eval)
			}
			require.NoError(t, err)
			defer query.Close()
			result := query.Exec(suite.context)
			require.NoError(t, result.Err)
			require.NoError(t, cmd.compareResult(result.Value))
			require.NoError(t, cmd.checkAnnotations(cmd.expr, result.Warnings))
			warnings, infos := result.Warnings.AsStrings(cmd.expr, 0, 0)
			encode := func(values []string) []string { out := []string{}; for _, value := range values { out = append(out, netdataHelperBytes(value)) }; sort.Strings(out); return out }
			source["caller_warnings"], source["caller_infos"] = encode(warnings), encode(infos)
		}()
		expectedCount := 0
		for _, entry := range cmd.expected { expectedCount += len(entry.vals) }
		require.Equal(t, expectedCount, native, "original statistic expansion changed")
		source["native_samples"], source["ignored_float_samples"] = native, ignored
		commands = append(commands, netdataHelperFreeze(source))
	}
	return commands
}
