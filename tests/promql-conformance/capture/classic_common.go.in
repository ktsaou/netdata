var netdataClassicCases []map[string]any
func netdataClassicBits(value float64) string { return fmt.Sprintf("%016x", math.Float64bits(value)) }
func netdataClassicFreeze(value any) json.RawMessage {
    raw, err := json.Marshal(value); if err != nil { panic(err) }; return raw
}
func netdataClassicBuckets(buckets Buckets) any {
    if buckets == nil { return nil }
    out := make([]any, len(buckets))
    for index, bucket := range buckets { out[index] = map[string]any{"upper_bound": netdataClassicBits(bucket.UpperBound), "count": netdataClassicBits(bucket.Count)} }
    return out
}
func netdataClassicQuantile(value float64) map[string]any { return map[string]any{"kind": "quantile", "quantile": netdataClassicBits(value)} }
func netdataClassicFraction(lower, upper float64) map[string]any { return map[string]any{"kind": "fraction", "lower": netdataClassicBits(lower), "upper": netdataClassicBits(upper)} }
func netdataClassicScalar(value float64, details any) any {
    reciprocal := 1 / value
    return map[string]any{"value": netdataClassicBits(value), "quantile": details, "reciprocal": netdataClassicBits(reciprocal),
        "negative_reciprocal_infinite": reciprocal == math.Inf(-1), "positive_reciprocal_infinite": reciprocal == math.Inf(1),
        "less_than_positive_infinity": value < math.Inf(1)}
}
func netdataClassicDetails(forced, fixed bool, min, max, decrease float64) any {
    return map[string]any{"forced_monotonicity": forced, "fixed_precision": fixed,
        "min_bound": netdataClassicBits(min), "max_bound": netdataClassicBits(max), "max_decrease": netdataClassicBits(decrease)}
}
func netdataClassicApply(id string, buckets Buckets, operations []map[string]any) {
    request := netdataClassicFreeze(map[string]any{"buckets": netdataClassicBuckets(buckets), "operations": operations})
    steps := []any{}
    for _, operation := range operations {
        panicked := true
        var result any
        func() {
            defer func() { recover() }()
            number := func(field string) float64 {
                var bits uint64
                _, err := fmt.Sscanf(operation[field].(string), "%016x", &bits); if err != nil { panic(err) }
                return math.Float64frombits(bits)
            }
            if operation["kind"] == "quantile" {
                val, forced, fixed, min, max, decrease := BucketQuantile(number("quantile"), buckets)
                result = netdataClassicScalar(val, netdataClassicDetails(forced, fixed, min, max, decrease))
            } else { result = netdataClassicScalar(BucketFraction(number("lower"), number("upper"), buckets), nil) }
            panicked = false
        }()
        steps = append(steps, map[string]any{"panicked": panicked, "result": result, "input_after": netdataClassicBuckets(buckets)})
    }
    netdataClassicCases = append(netdataClassicCases, map[string]any{"id": id, "mode": "classic-buckets", "request": request,
        "actual": netdataClassicFreeze(map[string]any{"steps": steps}), "declared": nil, "source": nil})
}
func netdataClassicOriginal(name string, q, want, epsilon float64, expectedForced, expectedFixed bool,
    request json.RawMessage, after Buckets, val float64, forced, fixed bool, min, max, decrease float64) {
    netdataClassicCases = append(netdataClassicCases, map[string]any{"id": "original-quantile:" + hex.EncodeToString([]byte(name)) + ":" + netdataClassicBits(q),
        "mode": "classic-buckets", "request": request, "actual": netdataClassicFreeze(map[string]any{"steps": []any{
            map[string]any{"panicked": false, "result": netdataClassicScalar(val, netdataClassicDetails(forced, fixed, min, max, decrease)), "input_after": netdataClassicBuckets(after)}}}),
        "declared": map[string]any{"comparison": "relative_epsilon", "value": netdataClassicBits(want), "epsilon": netdataClassicBits(epsilon),
            "forced_monotonicity": expectedForced, "fixed_precision": expectedFixed},
        "source": map[string]any{"file": "promql/quantile_test.go", "line": 315, "fixture": hex.EncodeToString([]byte(name))}})
}
func netdataClassicEqual(id string, a, b, epsilon float64, declared, source any) {
    netdataClassicCases = append(netdataClassicCases, map[string]any{"id": id, "mode": "almost-equal",
        "request": map[string]any{"left": netdataClassicBits(a), "right": netdataClassicBits(b), "epsilon": netdataClassicBits(epsilon)},
        "actual": almost.Equal(a, b, epsilon), "declared": declared, "source": source})
}

/* ORIGINAL_QUANTILE */
/* ORIGINAL_ALMOST */
/* SUPPLEMENTAL */

func TestNetdataCaptureClassic(t *testing.T) {
    output := os.Getenv("NETDATA_CLASSIC_CAPTURE")
    if output == "" { t.Skip("capture path not supplied") }
    if runtime.Version() != "go1.27.1" || runtime.GOOS != "linux" || runtime.GOARCH != "amd64" { t.Fatal("unexpected classic reference profile") }
    t.Run("untouched_original_quantile", TestBucketQuantile_ForcedMonotonicity)
    if t.Failed() { t.Fatal("original classic assertions failed") }
    netdataClassicCases = []map[string]any{}
    t.Run("observed_original_quantile", TestNetdataCopiedBucketQuantile)
    t.Run("observed_original_almost", TestNetdataCopiedAlmost)
    if t.Failed() { t.Fatal("copied original assertions failed") }
    netdataClassicSupplemental()
    sort.Slice(netdataClassicCases, func(i, j int) bool { return netdataClassicCases[i]["id"].(string) < netdataClassicCases[j]["id"].(string) })
    raw, err := json.MarshalIndent(map[string]any{"schema_version": 1, "commit": "5241a27fe3c6983549fccc32f6e65917408c63cd",
        "go_version": runtime.Version(), "go_os": runtime.GOOS, "go_arch": runtime.GOARCH,
        "original_assertions_passed": true, "cases": netdataClassicCases}, "", "  ")
    require.NoError(t, err)
    require.NoError(t, os.WriteFile(output, append(raw, '\n'), 0600))
}
