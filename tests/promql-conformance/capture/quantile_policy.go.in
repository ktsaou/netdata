package promql

import (
	"context"
	"fmt"
	"slices"
	"sort"

	"github.com/prometheus/prometheus/promql/parser"
	"github.com/prometheus/prometheus/util/annotations"
)

// NetdataQuantilePolicyFixture orders one declared map boundary, preserving its Matrix flags.
func NetdataQuantilePolicyFixture(ctx context.Context, public Query) (v parser.Value, child Matrix, ws annotations.Annotations, err error) {
	q, ok := public.(*query)
	if !ok {
		return nil, nil, nil, fmt.Errorf("policy requires an original query")
	}
	s, ok := q.stmt.(*parser.EvalStmt)
	if !ok || !s.End.After(s.Start) || s.Interval <= 0 {
		return nil, nil, nil, fmt.Errorf("policy requires an ordinary multistep scope")
	}
	aggregate, ok := s.Expr.(*parser.AggregateExpr)
	if !ok || aggregate.Op != parser.QUANTILE {
		return nil, nil, nil, fmt.Errorf("policy requires direct QUANTILE")
	}
	parameter, ok := aggregate.Param.(*parser.NumberLiteral)
	if !ok || parameter.Val != 0.5 {
		return nil, nil, nil, fmt.Errorf("policy requires literal q=0.5")
	}
	ng := q.ng
	mint, maxt := FindMinMaxTime(s)
	querier, err := q.queryable.Querier(mint, maxt)
	if err != nil {
		return nil, nil, nil, err
	}
	defer querier.Close()
	ng.populateSeries(ctx, querier, s)
	setOffsetForAtModifier(timeMilliseconds(s.Start), s.Expr)
	ev := &evaluator{
		startTimestamp: timeMilliseconds(s.Start), endTimestamp: timeMilliseconds(s.End),
		interval: durationMilliseconds(s.Interval), maxSamples: ng.maxSamplesPerQuery,
		logger: ng.logger, lookbackDelta: s.LookbackDelta, samplesStats: q.sampleStats,
		noStepSubqueryIntervalFn: ng.noStepSubqueryIntervalFn,
		enableDelayedNameRemoval: ng.enableDelayedNameRemoval,
		enableTypeAndUnitLabels:  ng.enableTypeAndUnitLabels, useStartTimestamps: ng.useStartTimestamps,
		querier: querier,
	}
	q.sampleStats.InitStepTracking(ev.startTimestamp, ev.endTimestamp, ev.interval)
	defer ev.recover(s.Expr, &ws, &err)
	grouping := slices.Clone(aggregate.Grouping)
	slices.Sort(grouping)
	params, notes := newFParams(ctx, ev, aggregate.Param)
	ws.Merge(notes)
	input, notes := ev.eval(ctx, aggregate.Expr)
	ws.Merge(notes)
	mat := input.(Matrix)
	// This is the sole policy change: raw labels at the original OR map boundary.
	sort.Sort(mat)
	child = make(Matrix, len(mat))
	for i, row := range mat {
		child[i] = row
		child[i].Floats = slices.Clone(row.Floats)
		child[i].Histograms = slices.Clone(row.Histograms)
		for j := range child[i].Histograms {
			child[i].Histograms[j].H = row.Histograms[j].H.Copy()
		}
	}
	result, notes := ev.rangeEvalAgg(ctx, aggregate, grouping, mat, params)
	ws.Merge(notes)
	v = result
	if ev.enableDelayedNameRemoval {
		v = ev.cleanupMetricLabels(v)
	}
	sort.Sort(v.(Matrix))
	return v, child, ws, nil
}
