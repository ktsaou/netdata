  "panels": [
    {
      "id": 1,
      "title": "Filesystem used",
      "description": "Highest usage among selected mounts, including reserved space in capacity.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (netdata_host_id, netdata_host_name) (100 * sum by (netdata_host_id, netdata_host_name, mount_point) (disk_space{netdata_host_name=~\"${host:regex}\",mount_point=~\"${mount:regex}\",netdata_dimension_id=\"used\"}) / on (netdata_host_id, netdata_host_name, mount_point) sum by (netdata_host_id, netdata_host_name, mount_point) (disk_space{netdata_host_name=~\"${host:regex}\",mount_point=~\"${mount:regex}\"}))",
          "editorMode": "code",
          "legendFormat": "{{netdata_host_name}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
