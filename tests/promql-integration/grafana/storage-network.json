        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(system_cpu, netdata_host_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(system_cpu, netdata_host_name)",
          "refId": "host-variable",
          "label": "netdata_host_name",
          "metric": "system_cpu"
        },
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
        "current": {
          "text": "promql",
          "value": "promql"
        }
      },
      {
        "name": "disk",
        "label": "Disk",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(disk_io{netdata_host_name=~\"${host:regex}\"}, device)",
        "query": {
          "qryType": 1,
          "query": "label_values(disk_io{netdata_host_name=~\"${host:regex}\"}, device)",
          "refId": "disk-variable",
          "label": "device",
          "metric": "disk_io{netdata_host_name=~\"${host:regex}\"}"
        },
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
