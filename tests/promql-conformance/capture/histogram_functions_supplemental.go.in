func netdataHelperSupplemental(output *[]map[string]any) {
	nan := func(bits uint64) float64 { return math.Float64frombits(bits) }
	base := &histogram.FloatHistogram{Schema: 0, Count: 2, Sum: 3,
		PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{1, 1}}
	fixtures := []*histogram.FloatHistogram{
		{},
		{Schema: 0, Count: 56, Sum: 113, ZeroThreshold: .5, ZeroCount: 7,
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 3}, {Offset: 2, Length: 3}}, PositiveBuckets: []float64{3, 11, 2, 9, 0, 6},
			NegativeSpans: []histogram.Span{{Offset: 1, Length: 2}, {Offset: 1, Length: 3}}, NegativeBuckets: []float64{4, 1, 8, 0, 5}},
		{Schema: 0, Count: 3, Sum: math.NaN(), PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{1, 1}},
		{Schema: 0, Count: 2, Sum: math.NaN(), PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{1, 1}},
		{Schema: 0, Count: 2, Sum: math.NaN(), PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{1, 0}},
		{Schema: 0, Count: 0, Sum: math.NaN(), PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{1, 1}},
		{Schema: 0, Count: 15, Sum: math.NaN(), PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{6, 6}},
		{Schema: 0, Count: 12, Sum: math.NaN(), PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{6, 6}},
		{Schema: histogram.CustomBucketsSchema, Count: 4, Sum: math.NaN(), CustomValues: []float64{-2, -1},
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 3}}, PositiveBuckets: []float64{1, 1, 1}},
		{Schema: histogram.CustomBucketsSchema, Count: 1, Sum: 0, CustomValues: []float64{-1, 1},
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 3}}, PositiveBuckets: []float64{0, 1, 0}},
		{Schema: 0, Count: 1, Sum: 0, ZeroCount: 1, ZeroThreshold: 0},
		base.Copy().Mul(-1), base.Copy().Mul(math.Inf(1)),
		{Schema: histogram.CustomBucketsSchema, Count: 36, Sum: 181, CustomValues: []float64{1, 2, 4, 8, 16},
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 3}, {Offset: 1, Length: 2}}, PositiveBuckets: []float64{2, 7, 5, 13, 9}},
		{Schema: 1, Count: 29, Sum: -87, NegativeSpans: []histogram.Span{{Offset: 0, Length: 3}, {Offset: 2, Length: 2}},
			NegativeBuckets: []float64{4, 9, 3, 8, 5}},
		{Schema: 0, Count: 8, Sum: -10, ZeroCount: 3, ZeroThreshold: .001,
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 1}}, PositiveBuckets: []float64{0},
			NegativeSpans: []histogram.Span{{Offset: 0, Length: 1}}, NegativeBuckets: []float64{5}},
		{Schema: 8, Count: 9, Sum: 17, ZeroCount: 1, ZeroThreshold: .25,
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{4, 4}},
		{Schema: 0, Count: nan(0x7ff8000000000042), Sum: nan(0x7ff8000000000099),
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{nan(0xfff8000000000027), nan(0x7ff8000000000063)}},
		{Schema: 0, Count: nan(0x7ff8000000000042), Sum: 0,
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{nan(0xfff8000000000027), nan(0x7ff8000000000063)}},
		{Schema: 0, Count: math.NaN(), Sum: math.NaN(), ZeroCount: math.NaN(), ZeroThreshold: math.NaN()},
		{Schema: 0, Count: 1, Sum: math.NaN(), PositiveSpans: []histogram.Span{{Offset: 0, Length: 2}}, PositiveBuckets: []float64{5, 5}},
		{Schema: 0, Count: 2, Sum: 0, ZeroCount: 2, ZeroThreshold: .5, PositiveBuckets: []float64{}, NegativeBuckets: []float64{}},
		{Schema: 0, Count: 2, Sum: math.NaN(),
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 1}}, PositiveBuckets: []float64{1},
			NegativeSpans: []histogram.Span{{Offset: 0, Length: 1}}, NegativeBuckets: []float64{1}},
	}
	quantiles := []float64{math.Inf(-1), -1, -math.SmallestNonzeroFloat64, math.Copysign(0, -1), 0, .25, .4, .5, .8, .9,
		1, math.Nextafter(1, math.Inf(1)), 2, math.Inf(1), nan(0x7ff8000000000001), nan(0xfff8000000000027),
		nan(0x7ff0000000000002), math.SmallestNonzeroFloat64}
	thresholds := []float64{math.Inf(-1), -6, -2, -1, -.5, -.125, math.Copysign(0, -1), 0, .125, .5, 1, 2, 6,
		math.Inf(1), nan(0x7ff8000000000001), nan(0xfff8000000000027), nan(0x7ff0000000000002)}
	for index, h := range fixtures {
		for qIndex, q := range quantiles {
			netdataHelperApply(output, fmt.Sprintf("supplement:quantile:%03d:%03d", index, qIndex), h, q, 0, true, "", "", posrange.PositionRange{})
		}
		for lowerIndex, lower := range thresholds {
			for upperIndex, upper := range thresholds {
				netdataHelperApply(output, fmt.Sprintf("supplement:fraction:%03d:%03d:%03d", index, lowerIndex, upperIndex), h,
					lower, upper, false, "", "", posrange.PositionRange{})
			}
		}
	}
	const maxInt = int(^uint(0) >> 1)
	const minInt = -maxInt - 1
	contexts := []struct { query string; start int }{
		{"", 0}, {"h", 0}, {"h", 1}, {"h", 2}, {"h", -1},
		{"é\nh", 0}, {"é\nh", 1}, {"é\nh", 2}, {"é\nh", 3}, {"é\nh", 4}, {"a\r\nh", 3},
		{string([]byte{0xff, '\n', 'h'}), 1}, {string([]byte{0xff, '\n', 'h'}), 2}, {string([]byte{0xff, '\n', 'h'}), 3},
		{"h", minInt}, {"h", maxInt},
	}
	for metricIndex, metric := range []string{"", "metric", "line\n\"\\\x00\xff", "k😀é\u200b"} {
		for contextIndex, context := range contexts {
			for kind := 0; kind < 3; kind++ {
				quantile, lower, upper := true, float64(0), float64(0)
				if kind == 1 { lower = 1 }
				if kind == 2 { quantile, lower, upper = false, math.Inf(-1), math.Inf(1) }
				pos := posrange.PositionRange{Start: posrange.Pos(context.start), End: posrange.Pos(context.start)}
				netdataHelperApply(output, fmt.Sprintf("supplement:annotation:%d:%d:%d", metricIndex, contextIndex, kind), fixtures[2],
					lower, upper, quantile, metric, context.query, pos)
			}
		}
	}
}
