{
  "id": null,
  "uid": "nd-promql-storage",
  "title": "Netdata / Storage & Network",
  "description": "Device, filesystem and network views. Configure options=absolute for correct historical sent/write counter rates.",
  "tags": [
    "netdata",
    "promql-playground"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 0,
  "refresh": "1m",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
