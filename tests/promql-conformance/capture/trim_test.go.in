package /* PACKAGE */

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"runtime"
	"testing"
	"github.com/stretchr/testify/require"
	/* IMPORTS */
)

/* ALIASES */

func netdataTrimNumber(value float64) string { return fmt.Sprintf("%016x", math.Float64bits(value)) }

func netdataTrimNumbers(input []float64) any {
	if input == nil { return nil }
	result := make([]string, len(input))
	for i, value := range input { result[i] = netdataTrimNumber(value) }
	return result
}

func netdataTrimFloat(input *netdataTrimHistogram) any {
	return map[string]any{"reset_hint": input.CounterResetHint, "schema": input.Schema,
		"zero_threshold": netdataTrimNumber(input.ZeroThreshold), "zero_count": netdataTrimNumber(input.ZeroCount),
		"count": netdataTrimNumber(input.Count), "sum": netdataTrimNumber(input.Sum),
		"positive_spans": input.PositiveSpans, "negative_spans": input.NegativeSpans,
		"positive_buckets": netdataTrimNumbers(input.PositiveBuckets),
		"negative_buckets": netdataTrimNumbers(input.NegativeBuckets), "custom_values": netdataTrimNumbers(input.CustomValues)}
}

func netdataTrimFrozen(value any) any {
	raw, err := json.Marshal(value)
	if err != nil { panic(err) }
	var result any
	if err := json.Unmarshal(raw, &result); err != nil { panic(err) }
	return result
}

func netdataTrimRecord(output *[]map[string]any, id, mode string, request, actual, declared any) {
	*output = append(*output, map[string]any{"id": id, "mode": mode,
		"request": netdataTrimFrozen(request), "actual": netdataTrimFrozen(actual), "declared": netdataTrimFrozen(declared)})
}

func netdataTrimRequest(h *netdataTrimHistogram, rhs float64, upper, copy bool) any {
	return netdataTrimFrozen(map[string]any{"input": netdataTrimFloat(h), "threshold": netdataTrimNumber(rhs),
		"upper_trim": upper, "copy": copy})
}

func netdataTrimActual(input, receiver, returned *netdataTrimHistogram, message string) any {
	return map[string]any{"input_after": netdataTrimFloat(input), "receiver_after": netdataTrimFloat(receiver),
		"returned_receiver": returned == receiver, "panic": message}
}

func netdataTrimApply(output *[]map[string]any, id string, input *netdataTrimHistogram, rhs float64, upper, copy bool) {
	request := netdataTrimRequest(input, rhs, upper, copy)
	receiver := input
	if copy { receiver = input.Copy() }
	var returned *netdataTrimHistogram
	message := ""
	func() {
		defer func() { if failure := recover(); failure != nil { message = fmt.Sprint(failure) } }()
		returned = receiver.TrimBuckets(rhs, upper)
	}()
	netdataTrimRecord(output, id, "float-trim", request, netdataTrimActual(input, receiver, returned, message), nil)
}

/* CAPTURE_FUNCTIONS */

func TestNetdataCaptureTrim(t *testing.T) {
	destination := os.Getenv("NETDATA_TRIM_CAPTURE_/* PACKAGE */")
	if destination == "" { t.Skip("capture path not supplied") }
	if runtime.Version() != "go1.27.1" || runtime.GOOS != "linux" || runtime.GOARCH != "amd64" {
		t.Fatal("unexpected trim reference build profile")
	}
	/* ORIGINAL_ASSERTIONS */
	if t.Failed() { t.Fatal("original trim assertions failed") }
	cases := []map[string]any{}
	/* CAPTURE_CALLS */
	if t.Failed() { t.Fatal("instrumented trim assertions failed") }
	raw, err := json.MarshalIndent(map[string]any{"schema_version": 1,
		"commit": "5241a27fe3c6983549fccc32f6e65917408c63cd", "go_version": runtime.Version(),
		"go_os": runtime.GOOS, "go_arch": runtime.GOARCH, "original_assertions_passed": true, "cases": cases}, "", "  ")
	if err != nil { t.Fatal(err) }
	if err := os.WriteFile(destination, append(raw, '\n'), 0600); err != nil { t.Fatal(err) }
}
