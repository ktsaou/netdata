package /* PACKAGE */

import (
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
	"math"
	"os"
	"runtime"
	"sort"
	"testing"
	"github.com/prometheus/prometheus/model/histogram"
	"github.com/prometheus/prometheus/promql/parser/posrange"
	"github.com/prometheus/prometheus/util/annotations"
	"github.com/stretchr/testify/require"
	/* IMPORTS */
)

/* HELPER_ALIASES */

func netdataHelperBits(value float64) string { return fmt.Sprintf("%016x", math.Float64bits(value)) }
func netdataHelperBytes(value string) string { return hex.EncodeToString([]byte(value)) }
func netdataHelperNumbers(values []float64) any {
	if values == nil { return nil }
	out := make([]string, len(values))
	for index, value := range values { out[index] = netdataHelperBits(value) }
	return out
}
func netdataHelperHistogram(h *histogram.FloatHistogram) any {
	return map[string]any{"reset_hint": h.CounterResetHint, "schema": h.Schema,
		"zero_threshold": netdataHelperBits(h.ZeroThreshold), "zero_count": netdataHelperBits(h.ZeroCount),
		"count": netdataHelperBits(h.Count), "sum": netdataHelperBits(h.Sum),
		"positive_spans": h.PositiveSpans, "negative_spans": h.NegativeSpans,
		"positive_buckets": netdataHelperNumbers(h.PositiveBuckets),
		"negative_buckets": netdataHelperNumbers(h.NegativeBuckets), "custom_values": netdataHelperNumbers(h.CustomValues)}
}
func netdataHelperFreeze(value any) json.RawMessage {
	raw, err := json.Marshal(value)
	if err != nil { panic(err) }
	return raw
}
func netdataHelperRequest(h *histogram.FloatHistogram, lower, upper float64, quantile bool, metric, query string, pos posrange.PositionRange) json.RawMessage {
	out := map[string]any{"input": netdataHelperHistogram(h), "metric_name": netdataHelperBytes(metric),
		"query": netdataHelperBytes(query), "position": map[string]any{"start": pos.Start, "end": pos.End}}
	if quantile { out["quantile"] = netdataHelperBits(lower) } else {
		out["lower"], out["upper"] = netdataHelperBits(lower), netdataHelperBits(upper)
	}
	return netdataHelperFreeze(out)
}
func netdataHelperAnnotations(annos annotations.Annotations, query string) any {
	if annos == nil { return nil }
	keys := make([]string, 0, len(annos))
	for key := range annos { keys = append(keys, key) }
	sort.Strings(keys)
	annos.AsStrings(query, 0, 0)
	out := make([]any, 0, len(keys))
	for _, key := range keys {
		err := annos[key]
		identity := ""
		switch {
		case errors.Is(err, annotations.NativeHistogramQuantileNaNResultInfo): identity = "NativeHistogramQuantileNaNResultInfo"
		case errors.Is(err, annotations.NativeHistogramQuantileNaNSkewInfo): identity = "NativeHistogramQuantileNaNSkewInfo"
		case errors.Is(err, annotations.NativeHistogramFractionNaNsInfo): identity = "NativeHistogramFractionNaNsInfo"
		default: panic("unknown native helper annotation")
		}
		if !errors.Is(err, annotations.PromQLInfo) { panic("helper annotation is not info") }
		out = append(out, map[string]any{"identity": identity, "severity": "info", "raw": netdataHelperBytes(key),
			"formatted": netdataHelperBytes(err.Error())})
	}
	return out
}
func netdataHelperRecord(output *[]map[string]any, id string, request json.RawMessage, h *histogram.FloatHistogram,
	value float64, annos annotations.Annotations, query string, quantile bool, declared, source any) {
	mode := "histogram-fraction"
	if quantile { mode = "histogram-quantile" }
	reciprocal := 1 / value
	actual := map[string]any{"value": netdataHelperBits(value), "input_after": netdataHelperHistogram(h),
		"annotations": netdataHelperAnnotations(annos, query), "reciprocal": netdataHelperBits(reciprocal),
		"negative_reciprocal_infinite": reciprocal == math.Inf(-1), "positive_reciprocal_infinite": reciprocal == math.Inf(1)}
	*output = append(*output, map[string]any{"id": id, "mode": mode, "request": request,
		"actual": netdataHelperFreeze(actual), "declared": netdataHelperFreeze(declared), "source": netdataHelperFreeze(source)})
}
func netdataHelperApply(output *[]map[string]any, id string, h *histogram.FloatHistogram, lower, upper float64, quantile bool,
	metric, query string, pos posrange.PositionRange) {
	request := netdataHelperRequest(h, lower, upper, quantile, metric, query, pos)
	var value float64
	var annos annotations.Annotations
	if quantile { value, annos = netdataHelperQuantile(lower, h, metric, pos) } else {
		value, annos = netdataHelperFraction(lower, upper, h, metric, pos)
	}
	netdataHelperRecord(output, id, request, h, value, annos, query, quantile, nil, nil)
}
func netdataHelperWrite(t *testing.T, cases []map[string]any, commands any) {
	t.Helper()
	if t.Failed() { t.Fatal("original native helper assertions failed") }
	raw, err := json.MarshalIndent(map[string]any{"schema_version": 1,
		"commit": "5241a27fe3c6983549fccc32f6e65917408c63cd", "go_version": runtime.Version(),
		"go_os": runtime.GOOS, "go_arch": runtime.GOARCH, "original_assertions_passed": true,
		"cases": cases, "commands": commands}, "", "  ")
	require.NoError(t, err)
	require.NoError(t, os.WriteFile(os.Getenv("NETDATA_HISTOGRAM_FUNCTIONS_/* PACKAGE */"), append(raw, '\n'), 0600))
}

/* CAPTURE_FUNCTIONS */

func TestNetdataCaptureHistogramFunctions(t *testing.T) {
	if os.Getenv("NETDATA_HISTOGRAM_FUNCTIONS_/* PACKAGE */") == "" { t.Skip("capture path not supplied") }
	if runtime.Version() != "go1.27.1" || runtime.GOOS != "linux" || runtime.GOARCH != "amd64" {
		t.Fatal("unexpected native helper reference profile")
	}
	/* CAPTURE_BODY */
}
