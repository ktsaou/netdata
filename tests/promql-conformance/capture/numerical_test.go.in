package math_test

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"runtime"
	"strconv"
	"testing"
)

func netdataNumericalBits(value float64) string {
	return fmt.Sprintf("%016x", math.Float64bits(value))
}

func netdataNumericalResult(mode string, input float64) any {
	switch mode {
	case "math-frexp":
		fraction, exponent := math.Frexp(input)
		return map[string]any{"fraction": netdataNumericalBits(fraction), "exponent": exponent}
	case "math-log":
		return netdataNumericalBits(math.Log(input))
	case "math-log2":
		return netdataNumericalBits(math.Log2(input))
	case "math-sqrt":
		return netdataNumericalBits(math.Sqrt(input))
	case "math-set":
		return map[string]any{"frexp": netdataNumericalResult("math-frexp", input),
			"log": netdataNumericalResult("math-log", input), "log2": netdataNumericalResult("math-log2", input),
			"sqrt": netdataNumericalResult("math-sqrt", input)}
	default:
		panic("unknown numerical mode")
	}
}

func TestNetdataCaptureNumerical(t *testing.T) {
	destination := os.Getenv("NETDATA_NUMERICAL_CAPTURE")
	if destination == "" {
		t.Skip("capture path not supplied")
	}
	if runtime.Version() != "go1.27.1" || runtime.GOOS != "linux" || runtime.GOARCH != "amd64" {
		t.Fatal("unexpected numerical reference profile")
	}
	for _, assertion := range []struct {
		name string
		run  func(*testing.T)
	}{{"TestFrexp", TestFrexp}, {"TestLog", TestLog}, {"TestLog2", TestLog2}, {"TestSqrt", TestSqrt}} {
		t.Run(assertion.name, assertion.run)
	}
	if t.Failed() {
		t.Fatal("original numerical assertions failed")
	}
	cases := []map[string]any{}
	record := func(id, mode string, input float64, expected any, comparison string) {
		var declared any
		if expected != nil {
			declared = map[string]any{"value": expected, "comparison": comparison}
		}
		cases = append(cases, map[string]any{"id": id, "mode": mode,
			"request": map[string]any{"input": netdataNumericalBits(input)},
			"actual":  netdataNumericalResult(mode, input), "declared": declared})
	}
	for i, input := range vf {
		record(fmt.Sprintf("TestFrexp:vf:%03d", i), "math-frexp", input,
			map[string]any{"fraction": netdataNumericalBits(frexp[i].f), "exponent": frexp[i].i}, "veryclose")
		record(fmt.Sprintf("TestLog:vf:%03d", i), "math-log", math.Abs(input), netdataNumericalBits(log[i]), "exact")
		record(fmt.Sprintf("TestLog2:vf:%03d", i), "math-log2", math.Abs(input), netdataNumericalBits(log2[i]), "veryclose")
		record(fmt.Sprintf("TestSqrt:vf:%03d", i), "math-sqrt", math.Abs(input), netdataNumericalBits(sqrt[i]), "exact")
	}
	for i, input := range vffrexpSC {
		record(fmt.Sprintf("TestFrexp:sc:%03d", i), "math-frexp", input,
			map[string]any{"fraction": netdataNumericalBits(frexpSC[i].f), "exponent": frexpSC[i].i}, "alike")
	}
	for i, input := range vffrexpBC {
		record(fmt.Sprintf("TestFrexp:bc:%03d", i), "math-frexp", input,
			map[string]any{"fraction": netdataNumericalBits(frexpBC[i].f), "exponent": frexpBC[i].i}, "alike")
	}
	record("TestLog:constant", "math-log", 10, netdataNumericalBits(math.Ln10), "exact")
	record("TestLog2:constant", "math-log2", math.E, netdataNumericalBits(math.Log2E), "exact")
	for i, input := range vflogSC {
		record(fmt.Sprintf("TestLog:sc:%03d", i), "math-log", input, netdataNumericalBits(logSC[i]), "alike")
		record(fmt.Sprintf("TestLog2:sc:%03d", i), "math-log2", input, netdataNumericalBits(logSC[i]), "alike")
	}
	for i, input := range vfsqrtSC {
		record(fmt.Sprintf("TestSqrt:sc:%03d", i), "math-sqrt", input, netdataNumericalBits(sqrtSC[i]), "alike")
	}
	for exponent := -1074; exponent <= 1023; exponent++ {
		input := math.Ldexp(1, exponent)
		record(fmt.Sprintf("TestLog2:power:%d", exponent), "math-log2", input, netdataNumericalBits(float64(exponent)), "exact")
		for direction, neighbor := range []float64{math.Nextafter(input, math.Inf(-1)), input, math.Nextafter(input, math.Inf(1))} {
			record(fmt.Sprintf("supplement:power:%d:%d", exponent, direction), "math-set", neighbor, nil, "")
		}
	}
	raw, err := os.ReadFile(os.Getenv("NETDATA_NUMERICAL_BOUNDS"))
	if err != nil {
		t.Fatal(err)
	}
	var bounds []string
	if err := json.Unmarshal(raw, &bounds); err != nil || len(bounds) != 511 {
		t.Fatal("changed compiled histogram bounds")
	}
	for index, text := range bounds {
		bits, err := strconv.ParseUint(text, 16, 64)
		if err != nil {
			t.Fatal(err)
		}
		input := math.Float64frombits(bits)
		for direction, neighbor := range []float64{math.Nextafter(input, math.Inf(-1)), input, math.Nextafter(input, math.Inf(1))} {
			record(fmt.Sprintf("supplement:bound:%d:%d", index, direction), "math-set", neighbor, nil, "")
		}
	}
	for index, bits := range []uint64{0, 1 << 63, 0x7ff0000000000000, 0xfff0000000000000,
		0x7ff8000000000001, 0xfff8000000000001, 0x7ff0000000000002, 0xfff0000000000002,
		0x8000000000000001, 0xffefffffffffffff, 0xbff0000000000000, 0x0010000000000001} {
		record(fmt.Sprintf("supplement:special:%d", index), "math-set", math.Float64frombits(bits), nil, "")
	}
	raw, err = json.MarshalIndent(map[string]any{"schema_version": 1, "go_version": runtime.Version(),
		"go_os": runtime.GOOS, "go_arch": runtime.GOARCH, "original_assertions_passed": true, "cases": cases}, "", "  ")
	if err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(destination, append(raw, '\n'), 0600); err != nil {
		t.Fatal(err)
	}
}
