      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (netdata_host_id, netdata_host_name) (timestamp(system_cpu{netdata_host_name=~\"${host}\",netdata_dimension_id=\"idle\"}))",
          "editorMode": "code",
          "legendFormat": "{{netdata_host_name}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "datasource": {
