  "mechanism": {
    "before": "The no-op closure nested in generic acquire retains the consuming callback type in its compiler identity, producing separate copies of the same validation traversal.",
    "after": "A named no-op visitor permits validation traversal sharing across consuming callback types while preserving the error type.",
    "ownership": "No new fields, allocations, caches, history buffers, limits, interfaces or dependencies.",
    "behavior": "Same complete page validation, error and cancellation phases, saved traversal state, consuming pass, useful-read credits and cleanup.",
    "limits": "This does not implement the rejected Present acquisition-reuse experiment or remove any required storage traversal."
  },
