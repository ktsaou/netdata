func netdataStatisticSupplemental(t *testing.T, output *[]map[string]any) {
/* PRIOR_HISTOGRAM_FIXTURES */
	fixtures = append(fixtures,
		&histogram.FloatHistogram{Count: 3, Sum: math.NaN()},
		&histogram.FloatHistogram{Count: 0, Sum: 1, PositiveSpans: []histogram.Span{{Offset: 0, Length: 1}}, PositiveBuckets: []float64{1}},
		(&histogram.FloatHistogram{Count: 1, Sum: 0, ZeroCount: 1, ZeroThreshold: .5}).Mul(-1),
		&histogram.FloatHistogram{Schema: histogram.CustomBucketsSchema, Count: 1, Sum: 1.25e308,
			CustomValues: []float64{1e308, 1.5e308}, PositiveSpans: []histogram.Span{{Offset: 0, Length: 3}}, PositiveBuckets: []float64{0, 1, 0}},
		&histogram.FloatHistogram{Schema: histogram.CustomBucketsSchema, Count: 1, Sum: 0,
			CustomValues: []float64{-1, 1, 1.2e308}, PositiveSpans: []histogram.Span{{Offset: 0, Length: 4}},
			PositiveBuckets: []float64{0, 1, math.SmallestNonzeroFloat64, 0}},
		&histogram.FloatHistogram{Schema: histogram.CustomBucketsSchema, Count: 12, Sum: 0,
			CustomValues: []float64{-100000001, -99999999, -3, -2, -1, 0, 1, 2, 3, 99999999, 100000001},
			PositiveSpans: []histogram.Span{{Offset: 0, Length: 12}}, PositiveBuckets: []float64{0, 1, 0, 1, 1, 3, 3, 1, 1, 0, 1, 0}},
	)
	values := []float64{0, math.Copysign(0, -1), math.SmallestNonzeroFloat64, -math.SmallestNonzeroFloat64, 1, -1,
		math.Inf(1), math.Inf(-1), nan(0x7ff8000000000001), nan(0xfff8000000000063), nan(0x7ff0000000000063),
		nan(0xfff0000000000063), math.MaxFloat64, -math.MaxFloat64}
	for _, count := range values {
		for _, sum := range values { h := base.Copy(); h.Count, h.Sum = count, sum; fixtures = append(fixtures, h) }
	}
	for index, h := range fixtures {
		for _, function := range []string{"histogram_count", "histogram_sum", "histogram_avg", "histogram_stdvar", "histogram_stddev"} {
			netdataStatisticRecord(t, output, fmt.Sprintf("supplement:%03d:%s", index, function), function, h, nil, nil)
		}
	}
}
