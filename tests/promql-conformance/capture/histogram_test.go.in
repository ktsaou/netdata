)

func netdataNumbers(input []float64) any {
	if input == nil {
		return nil
	}
	output := make([]string, len(input))
	for i, value := range input {
		output[i] = fmt.Sprintf("%016x", math.Float64bits(value))
	}
	return output
}

func netdataFloat(input *FloatHistogram) any {
	if input == nil {
		return nil
	}
	return map[string]any{
		"reset_hint": input.CounterResetHint, "schema": input.Schema,
		"zero_threshold": fmt.Sprintf("%016x", math.Float64bits(input.ZeroThreshold)),
		"zero_count":     fmt.Sprintf("%016x", math.Float64bits(input.ZeroCount)),
		"count":          fmt.Sprintf("%016x", math.Float64bits(input.Count)),
		"sum":            fmt.Sprintf("%016x", math.Float64bits(input.Sum)),
		"positive_spans": input.PositiveSpans, "negative_spans": input.NegativeSpans,
		"positive_buckets": netdataNumbers(input.PositiveBuckets),
		"negative_buckets": netdataNumbers(input.NegativeBuckets),
		"custom_values":    netdataNumbers(input.CustomValues),
	}
}

func netdataInteger(input *Histogram) any {
	if input == nil {
		return nil
	}
	return map[string]any{
		"reset_hint": input.CounterResetHint, "schema": input.Schema,
		"zero_threshold": fmt.Sprintf("%016x", math.Float64bits(input.ZeroThreshold)),
		"zero_count":     input.ZeroCount, "count": input.Count,
		"sum":            fmt.Sprintf("%016x", math.Float64bits(input.Sum)),
		"positive_spans": input.PositiveSpans, "negative_spans": input.NegativeSpans,
		"positive_buckets": input.PositiveBuckets, "negative_buckets": input.NegativeBuckets,
		"custom_values": netdataNumbers(input.CustomValues),
	}
}

func netdataFrozen(input any) json.RawMessage {
	raw, err := json.Marshal(input)
	if err != nil {
		panic(err)
	}
	return raw
}

func netdataRecord(cases *[]map[string]any, id, mode string, request, actual, declared any) {
	*cases = append(*cases, map[string]any{"id": id, "mode": mode,
		"request": netdataFrozen(request), "actual": netdataFrozen(actual),
		"declared": netdataFrozen(declared)})
}

func netdataReductionResult(input *FloatHistogram, err error) any {
	message := ""
	if err != nil {
		message = err.Error()
	}
	return map[string]any{"result": netdataFloat(input), "error": message, "histogram_error": errors.As(err, &Error{})}
}

func netdataArithmeticCheckpoint(result, receiver, argument, correction *FloatHistogram, collision, reconciled bool, err error) any {
	message := ""
	if err != nil {
		message = err.Error()
	}
	return netdataFrozen(map[string]any{"result": netdataFloat(result), "receiver_after": netdataFloat(receiver),
		"argument_after": netdataFloat(argument), "compensation_after": netdataFloat(correction),
		"counter_reset_collision": collision, "nhcb_bounds_reconciled": reconciled,
		"error": message, "histogram_error": errors.As(err, &Error{})})
}

func netdataArithmeticPair(operation string, left, right, correction *FloatHistogram, compact bool) (request, actual any) {
	h, b := left.Copy(), right.Copy()
	var c *FloatHistogram
	if correction != nil {
		c = correction.Copy()
	}
	return netdataArithmeticApply(operation, h, b, c, compact)
}

func netdataArithmeticApply(operation string, h, b, c *FloatHistogram, compact bool) (request, actual any) {
	request = netdataFrozen(map[string]any{"operation": operation, "left": netdataFloat(h), "right": netdataFloat(b),
		"compensation": netdataFloat(c), "compact": compact})
	var result *FloatHistogram
	var collision, reconciled bool
	var err error
	switch operation {
	case "add":
		result, collision, reconciled, err = h.Add(b)
	case "sub":
		result, collision, reconciled, err = h.Sub(b)
	case "kahan":
		result, collision, reconciled, err = h.KahanAdd(b, c)
	default:
		panic("unknown arithmetic operation")
	}
	raw := netdataArithmeticCheckpoint(result, h, b, c, collision, reconciled, err)
	var fold, final any
	if operation == "kahan" && result != nil {
		result, collision, reconciled, err = h.Add(result)
		fold = netdataArithmeticCheckpoint(result, h, b, nil, collision, reconciled, err)
	}
	if compact && result != nil {
		final = netdataFrozen(netdataFloat(result.Compact(0)))
	}
	actual = map[string]any{"raw": raw, "fold": fold, "final": final}
	return request, actual
}

func netdataBucket(bucket Bucket[float64]) any {
	return map[string]any{"lower": fmt.Sprintf("%016x", math.Float64bits(bucket.Lower)),
		"upper": fmt.Sprintf("%016x", math.Float64bits(bucket.Upper)),
		"count": fmt.Sprintf("%016x", math.Float64bits(bucket.Count)), "index": bucket.Index,
		"lower_inclusive": bucket.LowerInclusive, "upper_inclusive": bucket.UpperInclusive}
}

func netdataBuckets(input []Bucket[float64]) any {
	if input == nil {
		return nil
	}
	output := make([]any, len(input))
	for i, bucket := range input {
		output[i] = netdataBucket(bucket)
	}
	return output
}

func netdataCollectBuckets(iterator BucketIterator[float64]) []Bucket[float64] {
	var buckets []Bucket[float64]
	for iterator.Next() {
		buckets = append(buckets, iterator.At())
	}
	return buckets
}

func netdataReverseBuckets(input []Bucket[float64]) []Bucket[float64] {
	if input == nil {
		return nil
	}
	output := make([]Bucket[float64], len(input))
	for i, value := range input {
		output[len(input)-i-1] = value
	}
	return output
}

func netdataIteratorDeclared(input map[string][]Bucket[float64]) any {
	buckets := map[string]any{}
	for route, values := range input {
		buckets[route] = netdataBuckets(values)
	}
	return map[string]any{"buckets": buckets, "panic": ""}
}

func netdataIteratorRoutes() []string {
	return []string{"all", "all-reverse", "positive", "negative", "positive-reverse", "negative-reverse", "low-positive", "low-negative"}
}

func netdataIteratorResult(h *FloatHistogram, routes []string, start float64, target int32) (output map[string]any) {
	output = map[string]any{"buckets": nil, "panic": ""}
	defer func() {
		if failure := recover(); failure != nil {
			output["panic"] = fmt.Sprint(failure)
		}
	}()
	buckets := map[string]any{}
	for _, route := range routes {
		var iterator BucketIterator[float64]
		switch route {
		case "all":
			iterator = h.AllBucketIterator()
		case "all-reverse":
			iterator = h.AllReverseBucketIterator()
		case "positive":
			iterator = h.PositiveBucketIterator()
		case "negative":
			iterator = h.NegativeBucketIterator()
		case "positive-reverse":
			iterator = h.PositiveReverseBucketIterator()
		case "negative-reverse":
			iterator = h.NegativeReverseBucketIterator()
		case "low-positive":
			value := h.floatBucketIterator(true, start, target)
			iterator = &value
		case "low-negative":
			value := h.floatBucketIterator(false, start, target)
			iterator = &value
		default:
			panic("unknown iterator route")
		}
		buckets[route] = netdataBuckets(netdataCollectBuckets(iterator))
	}
	output["buckets"] = buckets
	return output
}

// Preserve the original All iterator tests' independently assembled expectations.
func netdataDeclaredAll(h *FloatHistogram, negative, zero, positive, reverse bool) []Bucket[float64] {
	var output []Bucket[float64]
	appendSide := func(isPositive bool) {
		var iterator BucketIterator[float64]
		if isPositive {
			if reverse {
				iterator = h.PositiveReverseBucketIterator()
			} else {
				iterator = h.PositiveBucketIterator()
			}
		} else if reverse {
			iterator = h.NegativeBucketIterator()
		} else {
			iterator = h.NegativeReverseBucketIterator()
		}
		for iterator.Next() {
			bucket := iterator.At()
			if zero {
				if isPositive && bucket.Lower < h.ZeroThreshold {
					bucket.Lower = h.ZeroThreshold
				} else if !isPositive && bucket.Upper > -h.ZeroThreshold {
					bucket.Upper = -h.ZeroThreshold
				}
			}
			output = append(output, bucket)
		}
	}
	if reverse && positive {
		appendSide(true)
	} else if !reverse && negative {
		appendSide(false)
	}
	if zero {
		output = append(output, Bucket[float64]{Lower: -h.ZeroThreshold, Upper: h.ZeroThreshold,
			LowerInclusive: true, UpperInclusive: true, Count: h.ZeroCount})
	}
	if reverse && negative {
		appendSide(false)
	} else if !reverse && positive {
		appendSide(true)
	}
	return output
}

func netdataLayoutSupplemental(cases *[]map[string]any) {
	for hint := UnknownCounterReset; hint <= GaugeType; hint++ {
		for shape := 0; shape < 4; shape++ {
			input := &FloatHistogram{CounterResetHint: hint, Schema: 1, Count: 5, Sum: -1, ZeroCount: 2, ZeroThreshold: 0.01}
			target := int32(0)
			switch shape {
			case 1:
				input.PositiveSpans = []Span{}
				input.NegativeSpans = []Span{}
				input.PositiveBuckets = []float64{}
				input.NegativeBuckets = []float64{}
			case 2:
				input.PositiveSpans = []Span{{-3, 4}}
				input.PositiveBuckets = []float64{1, 1e16, -1e16, 1}
				input.NegativeSpans = []Span{{0, 2}}
				input.NegativeBuckets = []float64{1, math.Copysign(0, -1)}
			case 3:
				input.Schema = CustomBucketsSchema
				target = CustomBucketsSchema
				input.PositiveSpans = []Span{{0, 2}}
				input.PositiveBuckets = []float64{0, 3}
				input.CustomValues = []float64{1, 2}
			}
			request := netdataFrozen(map[string]any{"input": netdataFloat(input), "target_schema": target})
			result := input.CopyToSchema(target)
			netdataRecord(cases, fmt.Sprintf("supplement:copy-to-schema:%d:%d", hint, shape), "float-copy-to-schema",
				request, map[string]any{"result": netdataFloat(result), "input_after": netdataFloat(input)}, nil)
		}
	}
	for shape := 0; shape < 8; shape++ {
		for _, maxEmpty := range []int{-1, 0, 2} {
			input := &FloatHistogram{CounterResetHint: GaugeType, Count: 3, Sum: -1, ZeroCount: 1, ZeroThreshold: 0.01}
			switch shape {
			case 1:
				input.PositiveSpans = []Span{}
				input.PositiveBuckets = []float64{}
			case 2:
				input.PositiveSpans = []Span{{0, 0}}
				input.PositiveBuckets = []float64{}
			case 3:
				input.PositiveSpans = []Span{{-1, 2}}
				input.PositiveBuckets = []float64{math.Copysign(0, -1), 0}
			case 4:
				input.PositiveSpans = []Span{{0, 4}}
				input.PositiveBuckets = []float64{math.Copysign(0, -1), math.NaN(), -1, 0}
			case 5:
				input.PositiveSpans = []Span{{0, 1}, {2, 0}, {0, 1}}
				input.PositiveBuckets = []float64{1, 2}
			case 6:
				input.PositiveSpans = []Span{{0, 0}}
			case 7:
				input.PositiveBuckets = []float64{}
			}
			request := netdataFrozen(map[string]any{"input": netdataFloat(input), "max_empty": maxEmpty})
			input.Compact(maxEmpty)
			netdataRecord(cases, fmt.Sprintf("supplement:compact:%d:%d", shape, maxEmpty), "float-compact", request, netdataFloat(input), nil)
		}
	}
	for shape := 0; shape < 8; shape++ {
		input := &FloatHistogram{CounterResetHint: CounterReset, Schema: 0, Count: 3, Sum: 5,
			PositiveSpans: []Span{{-2, 2}}, PositiveBuckets: []float64{1, 2},
			NegativeSpans: []Span{{0, 2}}, NegativeBuckets: []float64{1, 2}}
		target := int32(-1)
		switch shape {
		case 0:
			input.Schema = CustomBucketsSchema
		case 1:
			target = CustomBucketsSchema
		case 2:
			target = 0
		case 3:
			target = 1
		case 4:
			input.PositiveBuckets = []float64{1}
		case 5:
			input.NegativeBuckets = []float64{1}
		case 6:
			input.NegativeBuckets = []float64{1, 2, 3}
		case 7:
			input.NegativeSpans = []Span{{0, 1}, {-1, 1}}
		}
		request := netdataFrozen(map[string]any{"input": netdataFloat(input), "target_schema": target})
		err := input.ReduceResolution(target)
		netdataRecord(cases, fmt.Sprintf("supplement:reduce-resolution:%d", shape), "float-reduce-resolution", request, netdataReductionResult(input, err), nil)
	}
}

func netdataBoundSupplemental(cases *[]map[string]any) {
	var constants []any
	for schema, values := range exponentialBounds {
		constants = append(constants, netdataNumbers(values))
		for fraction := range values {
			for _, exponent := range []int32{-1076, -1075, -1074, -1023, -1022, -1, 0, 1023, 1024, 1025} {
				index := exponent*int32(len(values)) + int32(fraction)
				request := map[string]any{"index": index, "schema": schema}
				netdataRecord(cases, fmt.Sprintf("supplement:bound:%d:%d:%d", schema, fraction, exponent), "exponential-bound", request,
					fmt.Sprintf("%016x", math.Float64bits(getBoundExponential(index, int32(schema)))), nil)
			}
		}
	}
	for schema := int32(-4); schema < 0; schema++ {
		indices := []int32{math.MinInt32, -(1074 >> -schema) - 1, -(1074 >> -schema), -(1022 >> -schema) - 1,
			-(1022 >> -schema), -1, 0, 1, (1024 >> -schema) - 1, (1024 >> -schema), (1024 >> -schema) + 1, math.MaxInt32}
		for i, index := range indices {
			netdataRecord(cases, fmt.Sprintf("supplement:bound-negative:%d:%d", schema, i), "exponential-bound",
				map[string]any{"index": index, "schema": schema}, fmt.Sprintf("%016x", math.Float64bits(getBoundExponential(index, schema))), nil)
		}
	}
	netdataRecord(cases, "supplement:exponential-bound-table", "exponential-bound-table", map[string]any{}, constants, nil)
}

func netdataZeroResult(h *FloatHistogram) (output map[string]any) {
	output = map[string]any{"bucket": nil, "panic": ""}
	defer func() {
		if failure := recover(); failure != nil {
			output["panic"] = fmt.Sprint(failure)
		}
	}()
	output["bucket"] = netdataBucket(h.ZeroBucket())
	return output
}

func netdataZeroSupplemental(cases *[]map[string]any) {
	for shape := 0; shape < 6; shape++ {
		h := &FloatHistogram{}
		switch shape {
		case 1:
			h.ZeroThreshold, h.ZeroCount = math.Copysign(0, -1), math.Copysign(0, -1)
		case 2:
			h.ZeroThreshold, h.ZeroCount = math.NaN(), math.Inf(1)
		case 3:
			h.ZeroThreshold, h.ZeroCount = 0.01, -1
		case 4, 5:
			h.Schema = CustomBucketsSchema
			if shape == 5 {
				h.ZeroCount = 1
			}
		}
		netdataRecord(cases, fmt.Sprintf("supplement:zero-bucket:%d", shape), "float-zero-bucket",
			map[string]any{"input": netdataFloat(h)}, netdataZeroResult(h), nil)
	}
}

func netdataIteratorSupplemental(cases *[]map[string]any) {
	for shape := 0; shape < 12; shape++ {
		h := &FloatHistogram{Schema: 0, ZeroThreshold: 0.01}
		target := int32(0)
		routes := netdataIteratorRoutes()
		switch shape {
		case 0:
			h.PositiveSpans, h.PositiveBuckets = []Span{{-2, 6}}, []float64{1, 2, 3, 4, 5, 6}
		case 1:
			h.Schema = 1
			h.PositiveSpans, h.PositiveBuckets = []Span{{0, 5}}, []float64{1, 2, 3, 4, 5}
		case 2:
			h.Schema = 1
			h.PositiveSpans = []Span{{-3, 2}, {1, 0}, {2, 3}, {3, 0}}
			h.PositiveBuckets = []float64{1, 2, math.Copysign(0, -1), 4, 5}
		case 3:
			h.Schema = 1
			h.PositiveSpans, h.PositiveBuckets = []Span{{0, 5}}, []float64{1e16, 1, -1e16}
		case 4:
			h.PositiveSpans, h.PositiveBuckets = []Span{{0, 2}}, []float64{1, 2, 3, 4}
		case 5:
			h.ZeroCount = 2
		case 6:
			h.ZeroCount = 2
			h.PositiveSpans, h.PositiveBuckets = []Span{}, []float64{}
		case 7:
			h.PositiveSpans = []Span{{-1076, 4}, {2095, 4}}
			h.PositiveBuckets = []float64{0, math.Copysign(0, -1), 1, 2, 3, 4, math.Inf(1), math.NaN()}
		case 8:
			h.Schema, target = CustomBucketsSchema, CustomBucketsSchema
			h.PositiveSpans, h.PositiveBuckets = []Span{{0, 4}}, []float64{1, math.Copysign(0, -1), 3, 4}
			h.CustomValues = []float64{-1, 0, 1}
		case 9:
			h.ZeroThreshold = 0.6
			h.PositiveSpans, h.PositiveBuckets = []Span{{0, 2}}, []float64{0, 3}
		case 10:
			h.PositiveSpans = []Span{{0, 2}}
		case 11:
			h.Schema, target = 8, 8
			h.PositiveSpans = []Span{{-1024, 2048}}
			h.PositiveBuckets = make([]float64, 2048)
			for i := range h.PositiveBuckets {
				h.PositiveBuckets[i] = 1
			}
			routes = []string{"low-positive", "low-negative"}
		}
		if shape != 6 && shape != 8 {
			h.NegativeSpans, h.NegativeBuckets = h.PositiveSpans, h.PositiveBuckets
		}
		for i, start := range []float64{math.Copysign(0, -1), 0, 1, 1.5, math.Inf(1), math.NaN()} {
			request := netdataFrozen(map[string]any{"input": netdataFloat(h), "routes": routes,
				"start": fmt.Sprintf("%016x", math.Float64bits(start)), "target_schema": target})
			netdataRecord(cases, fmt.Sprintf("supplement:iterator:%d:%d", shape, i), "float-iterator-set", request,
				netdataIteratorResult(h, routes, start, target), nil)
		}
	}
	for shape := 0; shape < 7; shape++ {
		h := &FloatHistogram{Schema: 0}
		target := int32(0)
		routes := []string{"low-positive"}
		switch shape {
		case 0:
			h.Schema = CustomBucketsSchema
		case 1:
			target = CustomBucketsSchema
		case 2:
			target = 1
		case 3, 4:
			h.Schema, target = CustomBucketsSchema, CustomBucketsSchema
			h.CustomValues = []float64{-1, 0, 1}
			offset := int32(4)
			if shape == 4 {
				offset = -1
			}
			h.PositiveSpans, h.PositiveBuckets = []Span{{offset, 1}}, []float64{1}
		case 5, 6:
			h.Schema, target, h.ZeroCount = CustomBucketsSchema, CustomBucketsSchema, 1
			if shape == 5 {
				routes = []string{"all"}
			} else {
				routes = []string{"all-reverse"}
			}
		}
		request := netdataFrozen(map[string]any{"input": netdataFloat(h), "routes": routes,
			"start": fmt.Sprintf("%016x", math.Float64bits(0)), "target_schema": target})
		netdataRecord(cases, fmt.Sprintf("supplement:iterator-panic:%d", shape), "float-iterator-set", request,
			netdataIteratorResult(h, routes, 0, target), nil)
	}
}

func netdataResetResult(current, previous *FloatHistogram) any {
	reset := current.DetectReset(previous)
	return map[string]any{"reset": reset, "current_after": netdataFloat(current), "previous_after": netdataFloat(previous)}
}

func netdataThresholdResult(h, c *FloatHistogram, threshold float64) (output map[string]any) {
	output = map[string]any{"result": nil, "panic": ""}
	defer func() {
		if failure := recover(); failure != nil {
			output["panic"] = fmt.Sprint(failure)
		}
		output["input_after"], output["compensation_after"] = netdataFloat(h), netdataFloat(c)
	}()
	count, bound, correction := h.zeroCountForLargerThreshold(threshold, c)
	output["result"] = map[string]any{"count": fmt.Sprintf("%016x", math.Float64bits(count)),
		"threshold": fmt.Sprintf("%016x", math.Float64bits(bound)), "compensation": fmt.Sprintf("%016x", math.Float64bits(correction))}
	return output
}

func netdataCounterSupplemental(cases *[]map[string]any) {
	bounds := []struct{ left, right []float64 }{
		{nil, []float64{}}, {[]float64{0}, []float64{math.Copysign(0, -1)}},
		{[]float64{math.NaN()}, []float64{math.NaN()}},
		{[]float64{math.Float64frombits(0x7ff8000000000001)}, []float64{math.Float64frombits(0x7ff8000000000002)}},
		{[]float64{math.Inf(-1), math.Inf(1)}, []float64{math.Inf(-1), math.Inf(1)}},
		{[]float64{math.Inf(1)}, []float64{math.Inf(-1)}},
		{[]float64{1}, []float64{math.Nextafter(1, 2)}}, {[]float64{1, 1}, []float64{1, 1}},
	}
	for i, pair := range bounds {
		netdataRecord(cases, fmt.Sprintf("supplement:bounds-match:%d", i), "custom-bounds-match",
			map[string]any{"left": netdataNumbers(pair.left), "right": netdataNumbers(pair.right)},
			map[string]any{"forward": CustomBucketBoundsMatch(pair.left, pair.right), "reverse": CustomBucketBoundsMatch(pair.right, pair.left)}, nil)
	}
	for hint := UnknownCounterReset; hint <= GaugeType; hint++ {
		for shape := 0; shape < 4; shape++ {
			previous := &FloatHistogram{Count: 2}
			current := &FloatHistogram{Count: 2, CounterResetHint: hint}
			switch shape {
			case 0:
				current.Count = 1
			case 1:
				current.Count = 3
			case 2, 3:
				previous.PositiveSpans, previous.PositiveBuckets = []Span{{0, 1}}, []float64{1}
				if shape == 3 {
					previous.PositiveBuckets[0] = 0
				}
			}
			netdataRecord(cases, fmt.Sprintf("supplement:reset-hint:%d:%d", hint, shape), "float-detect-reset",
				map[string]any{"current": netdataFloat(current), "previous": netdataFloat(previous)}, netdataResetResult(current, previous), nil)
		}
	}
	for shape := 0; shape < 18; shape++ {
		previous := &FloatHistogram{Count: 10, ZeroThreshold: 0.01}
		current := &FloatHistogram{Count: 10, ZeroThreshold: 0.01}
		switch shape {
		case 0:
			current.Count = 9
		case 1:
			previous.PositiveSpans, previous.PositiveBuckets = []Span{{0, 1}}, []float64{1}
		case 2:
			previous.NegativeSpans, previous.NegativeBuckets = []Span{{0, 1}}, []float64{0}
		case 3:
			current.Sum, previous.Sum = math.NaN(), math.Inf(1)
		case 4:
			previous.Schema = 1
			previous.PositiveSpans, previous.PositiveBuckets = []Span{{0, 3}}, []float64{1, 1e16, -1e16}
			current.PositiveSpans, current.PositiveBuckets = []Span{{0, 2}}, []float64{1, 0}
		case 5, 6:
			current.ZeroThreshold, current.ZeroCount = 0.75, 1
			previous.PositiveSpans, previous.PositiveBuckets = []Span{{0, 1}}, []float64{1}
			if shape == 6 {
				previous.PositiveBuckets[0] = 0
			}
		case 7:
			previous.ZeroCount = 1e16
			previous.PositiveSpans, previous.PositiveBuckets = []Span{{0, 2}}, []float64{1, -1e16}
			current.ZeroThreshold = 2
		case 8:
			previous.PositiveSpans, previous.PositiveBuckets = []Span{{-1, 2}}, []float64{1, 0}
			previous.NegativeSpans, previous.NegativeBuckets = []Span{{0, 1}}, []float64{1e16}
			current.ZeroThreshold, current.ZeroCount = 1, 1e16
		case 9, 10:
			previous.PositiveSpans, previous.PositiveBuckets = []Span{{0, 1}}, []float64{math.NaN()}
			if shape == 9 {
				current.PositiveSpans, current.PositiveBuckets = []Span{{0, 1}}, []float64{math.NaN()}
			}
		case 11, 12:
			current.Schema, previous.Schema = CustomBucketsSchema, CustomBucketsSchema
			current.ZeroThreshold, previous.ZeroThreshold = 0, 0
			previous.CustomValues, current.CustomValues = []float64{1, 2}, []float64{2}
			previous.PositiveSpans, previous.PositiveBuckets = []Span{{0, 3}}, []float64{1, 2, 3}
			current.PositiveSpans, current.PositiveBuckets = []Span{{0, 2}}, []float64{2, 4}
			if shape == 12 {
				current.PositiveBuckets[0] = 3
			}
		case 13:
			current.Schema = CustomBucketsSchema
		case 14:
			current.Schema = 1
		case 15:
			current.CounterResetHint, current.Count = 255, 9
		case 16, 17:
			current.Schema = 9
			current.CounterResetHint = NotCounterReset
			if shape == 17 {
				current.CounterResetHint = CounterReset
			}
		}
		netdataRecord(cases, fmt.Sprintf("supplement:reset:%d", shape), "float-detect-reset",
			map[string]any{"current": netdataFloat(current), "previous": netdataFloat(previous)}, netdataResetResult(current, previous), nil)
	}
	for shape := 0; shape < 22; shape++ {
		h := &FloatHistogram{Schema: 0, ZeroThreshold: 0.01, ZeroCount: 0.25,
			PositiveSpans: []Span{{-1, 3}}, PositiveBuckets: []float64{1, 2, 3},
			NegativeSpans: []Span{{-1, 2}}, NegativeBuckets: []float64{4, 5}}
		threshold := 0.75
		switch shape {
		case 0:
			threshold = h.ZeroThreshold
		case 2:
			threshold = 1
		case 3:
			threshold = 1.5
		case 4:
			threshold = math.Inf(1)
		case 5:
			threshold = -1
		case 6:
			threshold = math.Inf(-1)
		case 7:
			threshold = math.NaN()
		case 8:
			h.PositiveBuckets[0] = math.NaN()
		case 9:
			h.ZeroCount = math.NaN()
		case 10:
			h.ZeroCount = math.Inf(1)
		case 11:
			h.NegativeBuckets[0] = math.Inf(1)
		case 12, 13:
			h.PositiveSpans, h.NegativeSpans, h.PositiveBuckets, h.NegativeBuckets = nil, nil, nil, nil
			h.ZeroCount = math.Copysign(0, -1)
			if shape == 13 {
				h.PositiveSpans, h.PositiveBuckets = []Span{}, []float64{}
			}
		case 14, 15:
			h.ZeroCount = 0
			h.PositiveSpans, h.PositiveBuckets = []Span{{-1, 2}}, []float64{1, 0}
			h.NegativeSpans, h.NegativeBuckets = []Span{{0, 1}}, []float64{1e16}
		case 16, 17:
			h.ZeroCount = 1e16
			h.PositiveSpans, h.PositiveBuckets = []Span{{0, 2}}, []float64{1, -1e16}
			h.NegativeSpans, h.NegativeBuckets = nil, nil
			threshold = 2
		case 18:
			h.Schema = 1
			h.PositiveSpans, h.PositiveBuckets = []Span{{0, 1}, {2, 0}, {3, 2}}, []float64{1, 2, 3}
		case 19:
			h.PositiveSpans, h.PositiveBuckets = []Span{{0, 1}, {-1, 1}}, []float64{1, 2}
		case 20, 21:
			h = &FloatHistogram{Schema: 0, PositiveSpans: []Span{{0, 1}}, PositiveBuckets: []float64{1}}
			if shape == 21 {
				h.PositiveSpans, h.PositiveBuckets, h.NegativeSpans, h.NegativeBuckets = nil, nil, h.PositiveSpans, h.PositiveBuckets
			}
			threshold = 2
		}
		var c *FloatHistogram
		if shape%2 == 1 {
			c = &FloatHistogram{Schema: h.Schema, ZeroThreshold: h.ZeroThreshold, ZeroCount: 0.125,
				PositiveSpans: h.PositiveSpans, NegativeSpans: h.NegativeSpans,
				PositiveBuckets: make([]float64, len(h.PositiveBuckets)), NegativeBuckets: make([]float64, len(h.NegativeBuckets))}
			for i := range c.PositiveBuckets {
				c.PositiveBuckets[i] = float64(i+1) / 100
			}
			for i := range c.NegativeBuckets {
				c.NegativeBuckets[i] = float64(i+1) / 100
			}
		}
		if shape >= 20 {
			c = &FloatHistogram{Schema: h.Schema, PositiveSpans: h.PositiveSpans, NegativeSpans: h.NegativeSpans}
		}
		netdataRecord(cases, fmt.Sprintf("supplement:zero-threshold:%d", shape), "float-zero-threshold",
			map[string]any{"input": netdataFloat(h), "compensation": netdataFloat(c), "threshold": fmt.Sprintf("%016x", math.Float64bits(threshold))},
			netdataThresholdResult(h, c, threshold), nil)
	}
}

func netdataArithmeticSupplemental(cases *[]map[string]any) {
	hints := []CounterResetHint{UnknownCounterReset, CounterReset, NotCounterReset, GaugeType, 4, 255}
	for _, left := range hints {
		for _, right := range hints {
			requests, results := []any{}, []any{}
			for _, operation := range []string{"add", "sub", "kahan"} {
				h := &FloatHistogram{CounterResetHint: left, Count: 1, Sum: 2, PositiveSpans: []Span{{0, 1}}, PositiveBuckets: []float64{1}}
				b := &FloatHistogram{CounterResetHint: right, Count: 1, Sum: 2, PositiveSpans: []Span{{0, 1}}, PositiveBuckets: []float64{1}}
				request, result := netdataArithmeticApply(operation, h, b, nil, true)
				requests, results = append(requests, request), append(results, result)
			}
			netdataRecord(cases, fmt.Sprintf("supplement:arithmetic-hints:%d:%d", left, right), "float-arithmetic-set",
				map[string]any{"operations": requests}, map[string]any{"operations": results}, nil)
		}
	}
	for shape := 0; shape < 20; shape++ {
		requests, results := []any{}, []any{}
		for _, operation := range []string{"add", "sub", "kahan"} {
			h := &FloatHistogram{CounterResetHint: GaugeType, Count: 4, ZeroCount: 1, ZeroThreshold: 0.01,
				PositiveSpans: []Span{{0, 2}}, PositiveBuckets: []float64{1, 1},
				NegativeSpans: []Span{{0, 1}}, NegativeBuckets: []float64{1}}
			b := &FloatHistogram{CounterResetHint: GaugeType, Count: 4, ZeroCount: 1, ZeroThreshold: 0.01,
				PositiveSpans: []Span{{0, 2}}, PositiveBuckets: []float64{2, 0},
				NegativeSpans: []Span{{0, 1}}, NegativeBuckets: []float64{1}}
			switch shape {
			case 0, 1:
				h = &FloatHistogram{Count: math.Copysign(0, -1), Sum: math.Copysign(0, -1), ZeroCount: math.Copysign(0, -1)}
				b = &FloatHistogram{}
				if shape == 1 {
					h.PositiveSpans, h.PositiveBuckets, h.NegativeSpans, h.NegativeBuckets = []Span{}, []float64{}, []Span{}, []float64{}
					b.PositiveSpans, b.PositiveBuckets, b.NegativeSpans, b.NegativeBuckets = []Span{}, []float64{}, []Span{}, []float64{}
				}
			case 2:
				h.PositiveBuckets = []float64{math.Copysign(0, -1), 0}
				b.PositiveBuckets = []float64{0, math.Copysign(0, -1)}
			case 3:
				h.Count, b.Count, h.Sum, b.Sum = math.Inf(1), math.Inf(-1), math.NaN(), math.Inf(1)
				h.PositiveBuckets, b.PositiveBuckets = []float64{math.Inf(1), math.NaN()}, []float64{math.Inf(-1), math.NaN()}
			case 4, 19:
				h.PositiveSpans, h.PositiveBuckets = []Span{{0, 3}}, []float64{1e16, 1, -1e16}
				b.PositiveSpans, b.PositiveBuckets = []Span{{0, 3}}, []float64{-1e16, 1, 1e16}
				if shape == 19 {
					h.Sum, b.Sum = math.SmallestNonzeroFloat64, -math.SmallestNonzeroFloat64
				}
			case 5, 6:
				h.PositiveSpans, h.PositiveBuckets = []Span{{-1, 4}}, []float64{1, 1e16, -1e16, 1}
				b.PositiveSpans, b.PositiveBuckets = []Span{{-1, 4}}, []float64{1, 1e16, -1e16, 1}
				if shape == 5 {
					h.Schema = 1
				} else {
					b.Schema = 1
				}
			case 7, 8:
				h.ZeroThreshold, b.ZeroThreshold = 0, 1.5
				h.NegativeSpans, h.NegativeBuckets = []Span{{2, 1}}, []float64{1}
				if shape == 8 {
					h.ZeroThreshold, b.ZeroThreshold = b.ZeroThreshold, h.ZeroThreshold
				}
			case 9, 10, 11, 12, 13, 16, 17, 18:
				h.Schema, b.Schema, h.ZeroThreshold, b.ZeroThreshold, h.ZeroCount, b.ZeroCount = CustomBucketsSchema, CustomBucketsSchema, 0, 0, 0, 0
				h.NegativeSpans, h.NegativeBuckets, b.NegativeSpans, b.NegativeBuckets = nil, nil, nil, nil
				h.CustomValues, b.CustomValues = []float64{1, 2}, []float64{1, 2}
				h.PositiveSpans, h.PositiveBuckets = []Span{{0, 3}}, []float64{1, 2, 3}
				b.PositiveSpans, b.PositiveBuckets = []Span{{0, 3}}, []float64{3, 2, 1}
				switch shape {
				case 10:
					b.CustomValues = []float64{2, 3}
					h.PositiveBuckets = []float64{1e16, 1, -1e16}
				case 11:
					h.CustomValues, b.CustomValues = []float64{1}, []float64{2}
					h.PositiveSpans, h.PositiveBuckets = []Span{{0, 2}}, []float64{1e16, 1}
					b.PositiveSpans, b.PositiveBuckets = []Span{{0, 2}}, []float64{-1e16, 0}
				case 12:
					h.CustomValues, b.CustomValues = nil, []float64{}
					h.PositiveSpans, h.PositiveBuckets = []Span{{0, 1}}, []float64{1}
					b.PositiveSpans, b.PositiveBuckets = []Span{{0, 1}}, []float64{2}
				case 13:
					h.CustomValues, b.CustomValues = []float64{0, 1}, []float64{math.Copysign(0, -1), 2}
				case 16:
					h.CustomValues, b.CustomValues = []float64{math.NaN(), 1}, []float64{math.NaN(), 2}
				case 17:
					h.CustomValues, b.CustomValues = []float64{1, math.Inf(1)}, []float64{2, math.Inf(1)}
				case 18:
					h.CustomValues, b.CustomValues = []float64{1}, []float64{2}
					h.PositiveSpans, h.PositiveBuckets, b.PositiveSpans, b.PositiveBuckets = nil, nil, []Span{}, []float64{}
				}
			case 14:
				b.Schema = CustomBucketsSchema
			case 15:
				h.Schema = CustomBucketsSchema
			}
			var c *FloatHistogram
			if operation == "kahan" && shape >= 4 {
				c = h.newCompensationHistogram()
				c.ZeroCount, c.Count, c.Sum = 0.125, 0.25, 0.5
				for i := range c.PositiveBuckets {
					c.PositiveBuckets[i] = float64(i+1) / 100
				}
				for i := range c.NegativeBuckets {
					c.NegativeBuckets[i] = float64(i+1) / 100
				}
			}
			request, result := netdataArithmeticApply(operation, h, b, c, true)
			requests, results = append(requests, request), append(results, result)
		}
		netdataRecord(cases, fmt.Sprintf("supplement:arithmetic-shape:%d", shape), "float-arithmetic-set",
			map[string]any{"operations": requests}, map[string]any{"operations": results}, nil)
	}
	for shape := 0; shape < 8; shape++ {
		for _, maxEmpty := range []int{-1, 0, 2} {
			h := &FloatHistogram{PositiveSpans: []Span{{-2, 5}}, PositiveBuckets: []float64{0, 1, 0, 2, 0}}
			c := &FloatHistogram{PositiveSpans: []Span{{-2, 5}}, PositiveBuckets: []float64{1, 0, -1, 0, 1}}
			switch shape {
			case 1:
				h.PositiveSpans, h.PositiveBuckets, c.PositiveSpans, c.PositiveBuckets = nil, nil, nil, nil
			case 2:
				h.PositiveSpans, h.PositiveBuckets, c.PositiveSpans, c.PositiveBuckets = []Span{{1, 0}}, []float64{}, []Span{{1, 0}}, []float64{}
			case 3:
				h.PositiveSpans, h.PositiveBuckets = []Span{{0, 1}, {1, 1}, {1, 1}}, []float64{1, 2, 3}
				c.PositiveSpans, c.PositiveBuckets = []Span{{0, 1}, {1, 1}, {1, 1}}, []float64{0.1, 0.2, 0.3}
			case 4:
				c.PositiveBuckets = []float64{0, 0, 1, 0, 0}
			case 5:
				h.PositiveBuckets, c.PositiveBuckets = []float64{0, 0, 0, 0, 0}, []float64{0, math.Copysign(0, -1), 0, 0, 0}
			case 6:
				h.PositiveBuckets, c.PositiveBuckets = []float64{math.NaN(), 0, math.Inf(1), 0, 1}, []float64{0, 0, 0, math.NaN(), 0}
			case 7:
				h.PositiveSpans, c.PositiveSpans = []Span{{0, 2}, {0, 0}, {2, 3}}, []Span{{0, 2}, {0, 0}, {2, 3}}
			}
			if shape != 1 {
				h.NegativeSpans, h.NegativeBuckets = append([]Span{}, h.PositiveSpans...), append([]float64{}, h.PositiveBuckets...)
				c.NegativeSpans, c.NegativeBuckets = append([]Span{}, c.PositiveSpans...), append([]float64{}, c.PositiveBuckets...)
			}
			request := netdataFrozen(map[string]any{"input": netdataFloat(h), "compensation": netdataFloat(c), "max_empty": maxEmpty})
			h, c = h.kahanCompact(maxEmpty, c)
			netdataRecord(cases, fmt.Sprintf("supplement:kahan-compact:%d:%d", shape, maxEmpty), "float-kahan-compact", request,
				map[string]any{"input_after": netdataFloat(h), "compensation_after": netdataFloat(c)}, nil)
		}
	}
}

func netdataSupplemental(cases *[]map[string]any) {
	for hint := UnknownCounterReset; hint <= GaugeType; hint++ {
		for _, schema := range []int32{0, CustomBucketsSchema} {
			for i, factor := range []float64{0, math.Copysign(0, -1), -1, math.Inf(1), math.Inf(-1), math.NaN()} {
				for _, mode := range []string{"float-mul", "float-div"} {
					input := &FloatHistogram{CounterResetHint: hint, Schema: schema,
						ZeroThreshold: 0.01, ZeroCount: 0, Count: 3, Sum: -1,
						PositiveSpans: []Span{{0, 2}}, PositiveBuckets: []float64{0, 3},
						NegativeSpans: []Span{{0, 1}}, NegativeBuckets: []float64{math.Copysign(0, -1)}}
					if schema == CustomBucketsSchema {
						input.CustomValues = []float64{1, 2}
					}
					request := netdataFrozen(map[string]any{"input": netdataFloat(input),
						"scalar": fmt.Sprintf("%016x", math.Float64bits(factor))})
					if mode == "float-mul" {
						input.Mul(factor)
					} else {
						input.Div(factor)
					}
					netdataRecord(cases, fmt.Sprintf("supplement:arithmetic:%s:%d:%d:%d", mode, hint, schema, i),
						mode, request, netdataFloat(input), nil)
				}
			}
		}
	}
	for i, deltas := range [][]int64{{1 << 53, 1, 1}, {1 << 53, 1, -(1 << 53)},
		{math.MaxInt64, -math.MaxInt64, 1}, {-1 << 53, -1, -1}} {
		input := &Histogram{CounterResetHint: NotCounterReset, Schema: 3,
			Count: math.MaxUint64, ZeroCount: 1<<53 + 1,
			PositiveSpans: []Span{{0, uint32(len(deltas))}}, PositiveBuckets: deltas,
			NegativeSpans: []Span{{-1, uint32(len(deltas))}}, NegativeBuckets: deltas,
			Sum: math.Float64frombits(0x7ff0000000000002)}
		request := map[string]any{"input": netdataInteger(input), "destination": nil}
		netdataRecord(cases, fmt.Sprintf("supplement:integer-to-float:%d", i), "integer-to-float",
			request, netdataFloat(input.ToFloat(nil)), nil)
	}
	values := []float64{0, math.Copysign(0, -1), 1, -1, 1e16, -1e16,
		math.MaxFloat64, -math.MaxFloat64, math.Inf(1), math.Inf(-1), math.NaN()}
	for i, sum := range values {
		for j, increment := range values {
			for _, mode := range []string{"compensated-add", "compensated-sub"} {
				compensation := 0.25
				request := map[string]any{"sum": fmt.Sprintf("%016x", math.Float64bits(sum)),
					"increment":    fmt.Sprintf("%016x", math.Float64bits(increment)),
					"compensation": fmt.Sprintf("%016x", math.Float64bits(compensation))}
				var total, correction float64
				if mode == "compensated-add" {
					total, correction = kahansum.Inc(increment, sum, compensation)
				} else {
					total, correction = kahansum.Dec(increment, sum, compensation)
				}
				netdataRecord(cases, fmt.Sprintf("supplement:%s:%d:%d", mode, i, j), mode, request,
					map[string]any{"sum": fmt.Sprintf("%016x", math.Float64bits(total)),
						"compensation": fmt.Sprintf("%016x", math.Float64bits(correction))}, nil)
			}
		}
	}
}

func TestNetdataCaptureHistogram(t *testing.T) {
	destination := os.Getenv("NETDATA_HISTOGRAM_CAPTURE")
	if destination == "" {
		t.Skip("capture path not supplied")
	}
	if runtime.Version() != "go1.27.1" {
		t.Fatal("unexpected Go toolchain")
	}
	for _, assertion := range []struct {
		name string
		run  func(*testing.T)
	}{
		/* ORIGINAL_ASSERTIONS */
	} {
		t.Run(assertion.name, assertion.run)
	}
	if t.Failed() {
		t.Fatal("original histogram assertions failed")
	}
	cases := []map[string]any{}
	/* CAPTURE_CALLS */
	netdataSupplemental(&cases)
	netdataLayoutSupplemental(&cases)
	netdataBoundSupplemental(&cases)
	netdataIteratorSupplemental(&cases)
	netdataZeroSupplemental(&cases)
	netdataCounterSupplemental(&cases)
	netdataArithmeticSupplemental(&cases)
	raw, err := json.MarshalIndent(map[string]any{"schema_version": 1,
		"commit": "5241a27fe3c6983549fccc32f6e65917408c63cd", "go_version": runtime.Version(),
		"go_os": runtime.GOOS, "go_arch": runtime.GOARCH,
		"original_assertions_passed": true, "cases": cases}, "", "  ")
	if err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(destination, append(raw, '\n'), 0600); err != nil {
		t.Fatal(err)
	}
}

/* CAPTURE_HELPERS */
