{
  "id": null,
  "uid": "nd-pql-history-comparisons",
  "title": "Netdata / History and Forecasts",
  "description": "Practical multi-node PromQL workloads. Missing data stays missing; alert thresholds are examples.",
  "tags": [
    "netdata",
    "promql-playground"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 0,
  "refresh": "",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "24h",
      "7d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Netdata PromQL",
          "value": "netdata-promql"
        },
        "refresh": 1,
        "options": []
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(system_cpu, netdata_host_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(system_cpu, netdata_host_name)",
          "refId": "host-variable",
          "label": "netdata_host_name",
          "metric": "system_cpu"
        },
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "promql-playground"
      ],
      "title": "Netdata dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "CPU busy change versus one hour ago",
      "description": "Percentage-point change, matched by node identity.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        }
      },
      "maxDataPoints": 300,
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "expr": "(100 - avg by (netdata_host_id,netdata_host_name) (system_cpu{netdata_host_name=~\"${host}\",netdata_dimension_id=\"idle\"})) - ((100 - avg by (netdata_host_id,netdata_host_name) (system_cpu{netdata_host_name=~\"${host}\",netdata_dimension_id=\"idle\"} offset 1h)))",
          "editorMode": "code",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
