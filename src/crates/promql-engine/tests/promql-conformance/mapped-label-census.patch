+    #[test]
+    fn mapped_label_descriptor_availability_census() {
+        let mut queries = 0;
+        for page in [1, 17, 1024] {
+            for delayed in [false, true] {
+                for groups in [4, 16] {
+                    for instant in [false, true] {
+                        let provider = mapped_group_provider(page, groups);
+                        let engine = Engine::default();
+                        let control = Control::default();
+                        let query = engine
+                            .compile(
+                                b"sum by(instance)(abs(counter_total))",
+                                options(delayed),
+                                &control,
+                            )
+                            .unwrap();
+                        let request = if instant {
+                            QueryRequest::Instant { time_ms: 3000 }
+                        } else {
+                            QueryRequest::Range {
+                                start_ms: 3000,
+                                end_ms: 5000,
+                                step_ms: 1000,
+                            }
+                        };
+                        let (report, counts) =
+                            crate::evaluator::observe_mapped_label_census(|| {
+                                query.collect_reported(&provider, request, &control)
+                            });
+                        let result = report.result.as_ref().unwrap();
+                        assert!(report.annotations.is_empty());
+                        assert_eq!(result.series.len(), groups);
+                        let mut seen = vec![false; groups];
+                        for row in result.series.iter() {
+                            assert_eq!(row.labels.0.len(), 1);
+                            assert_eq!(&*row.labels.0[0].name, b"instance");
+                            let group: usize = std::str::from_utf8(&row.labels.0[0].value[1..])
+                                .unwrap()
+                                .parse()
+                                .unwrap();
+                            assert!(group < groups && !seen[group]);
+                            seen[group] = true;
+                            assert_eq!(&*row.labels.0[0].value, format!("g{group:04}").as_bytes());
+                            assert_eq!(row.points.len(), if instant { 1 } else { 3 });
+                            for (tick, point) in row.points.iter().enumerate() {
+                                let time = (tick + 3) as f64;
+                                let expected =
+                                    2.0 * time * if group.is_multiple_of(2) { 1.0 } else { 2.0 };
+                                assert_eq!(point.time_ms, (tick as i64 + 3) * 1000);
+                                assert_eq!(float_bits(point), expected.to_bits());
+                            }
+                        }
+                        assert!(seen.into_iter().all(|present| present));
+                        assert_eq!(counts[1], 0);
+                        assert!(counts[2] <= counts[0]);
+                        assert!(counts[3] <= counts[2]);
+                        assert_eq!(counts[3], counts[4] + counts[5]);
+                        assert_eq!(
+                            report.observations.memory[MemoryKind::Workspace as usize].current,
+                            0
+                        );
+                        println!(
+                            "mapped-label-census page={page} groups={groups} delayed={delayed} instant={instant} counts={counts:?}"
+                        );
+                        provider.assert_closed();
+                        drop((report, query));
+                        engine.accounting.snapshot().assert_memory_released();
+                        queries += 1;
+                    }
+                }
+            }
+        }
+        assert_eq!(queries, 24);
+    }
